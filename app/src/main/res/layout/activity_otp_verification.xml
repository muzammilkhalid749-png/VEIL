<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/otp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/textPrimary" />

    <!-- Main Scrollable Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/_440sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_24sdp"
            android:paddingTop="@dimen/_56sdp"
            android:paddingBottom="@dimen/_32sdp">

            <!-- Lock / Verification Icon -->
            <ImageView
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:contentDescription="@string/verify_phone_number"
                android:scaleType="fitCenter"
                android:src="@drawable/veil_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="@string/verify_phone_number"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_22ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneNumberText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="+1 XXX-XXX-1234"
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/enter_otp_hint"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_14ssp" />

            <!-- Sovereign Local OTP Instant Auto-Fill Pill -->
            <TextView
                android:id="@+id/tvSovereignOtpHelper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                android:background="@drawable/input_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="🔐 Sovereign Code: 123456 (Tap to auto-fill)"
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <!-- OTP Input Grid -->
            <com.mukeshsolanki.OtpView
                android:id="@+id/otpView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_28sdp"
                android:clickable="true"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:inputType="number"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                app:OtpHideLineWhenFilled="true"
                app:OtpItemCount="6"
                app:OtpItemHeight="@dimen/_50sdp"
                app:OtpItemRadius="@dimen/_12sdp"
                app:OtpItemSpacing="@dimen/_8sdp"
                app:OtpItemWidth="@dimen/_38sdp"
                app:OtpLineColor="@color/veil_accent"
                app:OtpLineWidth="@dimen/_2sdp"
                app:OtpViewType="rectangle" />

            <!-- Countdown Timer & Resend Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_28sdp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="02:00"
                    android:textColor="@color/veil_accent"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:text="•"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/resendCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="false"
                    android:fontFamily="sans-serif-medium"
                    android:padding="@dimen/_6sdp"
                    android:text="@string/resend_code"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_14ssp" />

            </LinearLayout>

            <!-- Verify Action Button with Centered In-Button Spinner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verifyButton"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:letterSpacing="0.01"
                    android:text="@string/verify_continue"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/_14sdp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="@dimen/_26sdp"
                    android:layout_height="@dimen/_26sdp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
