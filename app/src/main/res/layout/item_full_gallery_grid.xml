<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_100sdp"
    android:padding="@dimen/_1sdp">

    <ImageView
        android:id="@+id/ivGalleryThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#151C28" />

    <!-- Selection tint overlay -->
    <View
        android:id="@+id/viewSelectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#404F46E5"
        android:visibility="gone" />

    <!-- Video duration pill (bottom-left) -->
    <LinearLayout
        android:id="@+id/layoutVideoDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/_3sdp"
        android:background="@drawable/bg_media_overlay_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:src="@drawable/ic_play_arrow"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Selection Badge (top-right) with Counter like WhatsApp -->
    <FrameLayout
        android:id="@+id/layoutSelectionBadge"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/_3sdp"
        android:background="@drawable/bg_circle_translucent">

        <TextView
            android:id="@+id/tvSelectionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
