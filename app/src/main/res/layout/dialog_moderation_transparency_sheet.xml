<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_17sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Modern Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_12sdp" />

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_13sdp">

        <FrameLayout
            android:layout_width="@dimen/_37sdp"
            android:layout_height="@dimen/_37sdp"
            android:background="@drawable/bg_persona_avatar_circle"
            android:backgroundTint="@color/colorSurfaceVariant">

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_12sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decentralized Moderation"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peer consensus &amp; cryptographic transparency"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_10ssp"
                android:layout_marginTop="@dimen/_2sdp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseModeration"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_close"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <!-- Modern Filter Chips Tab Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="@dimen/_12sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabJuryCases"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:gravity="center"
                android:paddingStart="@dimen/_13sdp"
                android:paddingEnd="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:background="@drawable/bg_filter_chip"
                android:text="Jury Cases"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tabTransparencyLog"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:gravity="center"
                android:paddingStart="@dimen/_13sdp"
                android:paddingEnd="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:background="@drawable/bg_filter_chip"
                android:text="Audit Receipts"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tabAbuseStats"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_28sdp"
                android:gravity="center"
                android:paddingStart="@dimen/_13sdp"
                android:paddingEnd="@dimen/_13sdp"
                android:background="@drawable/bg_filter_chip"
                android:text="Network Metrics"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable Content View -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentModerationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
