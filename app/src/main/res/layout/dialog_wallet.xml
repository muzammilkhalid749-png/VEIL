<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_22sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_22sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Veil Wallet"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_19ssp" />

    <!-- Balance Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_18sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Available Balance"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/walletBalanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="0 VC"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_28ssp"
                app:autoSizeMaxTextSize="@dimen/_28ssp"
                app:autoSizeMinTextSize="@dimen/_18ssp"
                app:autoSizeStepGranularity="@dimen/_1ssp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/walletSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="sans-serif"
                android:text="Level 1 • 0 XP"
                android:textColor="@color/textTertiary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Send / Add Mode Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabSend"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Send"
            android:textSize="@dimen/_13ssp"
            app:cornerRadius="@dimen/_12sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabReceive"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Receive / Add"
            android:textSize="@dimen/_13ssp"
            app:cornerRadius="@dimen/_12sdp" />
    </LinearLayout>

    <!-- Send Container -->
    <LinearLayout
        android:id="@+id/sendContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/walletRecipientInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/bg_search_input"
            android:hint="Recipient @username"
            android:inputType="text"
            android:paddingStart="@dimen/_14sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="@dimen/_14ssp" />

        <EditText
            android:id="@+id/walletAmountInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_search_input"
            android:hint="Amount ($ USD)"
            android:inputType="numberDecimal"
            android:paddingStart="@dimen/_14sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="@dimen/_14ssp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSend"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:fontFamily="sans-serif-medium"
            android:text="Send Anonymously"
            android:textSize="@dimen/_14ssp"
            app:cornerRadius="@dimen/_12sdp" />
    </LinearLayout>

    <!-- Receive Container -->
    <LinearLayout
        android:id="@+id/receiveContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_56sdp"
            android:src="@drawable/ic_veil_shield"
            app:tint="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="sans-serif-medium"
            android:text="Your Veil Wallet Address"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_14ssp" />

        <TextView
            android:id="@+id/walletAddressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="sans-serif-medium"
            android:text="0x71C94B2E58A6D19F90A"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_13ssp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyAddress"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="sans-serif-medium"
            android:text="Copy Address"
            android:textSize="@dimen/_13ssp"
            app:cornerRadius="@dimen/_12sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaimDailyBonus"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:fontFamily="sans-serif-medium"
            android:text="Claim Daily Streak Bonus (+25 VC)"
            android:textSize="@dimen/_13ssp"
            app:cornerRadius="@dimen/_12sdp" />
    </LinearLayout>

</LinearLayout>
