<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Language"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_20ssp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_18sdp"
        android:text="Select your preferred application display language"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp" />

    <!-- Grouped Language Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/colorOutline"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow">

        <RadioGroup
            android:id="@+id/rgLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbLangEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:text="English"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium"
                app:buttonTint="@color/colorPrimary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="@color/colorOutline" />

            <RadioButton
                android:id="@+id/rbLangEs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:text="Español (Spanish)"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium"
                app:buttonTint="@color/colorPrimary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="@color/colorOutline" />

            <RadioButton
                android:id="@+id/rbLangFr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:text="Français (French)"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium"
                app:buttonTint="@color/colorPrimary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="@color/colorOutline" />

            <RadioButton
                android:id="@+id/rbLangDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:text="Deutsch (German)"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium"
                app:buttonTint="@color/colorPrimary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="@color/colorOutline" />

            <RadioButton
                android:id="@+id/rbLangAr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:text="العربية (Arabic)"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium"
                app:buttonTint="@color/colorPrimary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="@color/colorOutline" />

            <RadioButton
                android:id="@+id/rbLangUr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:text="اردو (Urdu)"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:fontFamily="sans-serif-medium"
                app:buttonTint="@color/colorPrimary" />

        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>