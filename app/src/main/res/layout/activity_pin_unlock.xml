<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/unlock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Main Scrollable Container (responsive for all screen sizes) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:maxWidth="440dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <!-- App Logo / Shield Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/colorPrimaryContainer"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/veil_logo"
                    app:tint="@color/colorPrimary" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="App Locked"
                android:textColor="@color/textPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Enter your PIN to continue"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

            <!-- PIN Progress Dots -->
            <LinearLayout
                android:id="@+id/pinDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Error Feedback -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/statusError"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Responsive Number Pad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="340dp"
                android:orientation="vertical">

                <!-- Row 1: 1, 2, 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button1"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="1"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/button2"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="2"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/button3"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="3"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />
                </LinearLayout>

                <!-- Row 2: 4, 5, 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button4"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="4"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/button5"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="5"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/button6"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="6"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />
                </LinearLayout>

                <!-- Row 3: 7, 8, 9 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button7"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="7"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/button8"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="8"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/button9"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="9"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />
                </LinearLayout>

                <!-- Row 4: Delete, 0, Clear -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonDelete"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif"
                        android:text="⌫"
                        android:textColor="@color/keypad_control_text"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/button0"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/keypad_digit_text"
                        android:textSize="24sp" />

                    <Button
                        android:id="@+id/buttonClear"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="C"
                        android:textColor="@color/keypad_control_text"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
