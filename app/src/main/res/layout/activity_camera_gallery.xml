<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cameraGalleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. Live CameraX Viewfinder (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Real-Time AR Mask Overlay View (#211) -->
    <com.m3.veil.utils.VeilArMaskOverlayView
        android:id="@+id/arMaskOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Animated Tap-to-Focus Ring Overlay -->
    <View
        android:id="@+id/viewFocusRing"
        android:layout_width="@dimen/_53sdp"
        android:layout_height="@dimen/_53sdp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="gone" />

    <!-- 3. Top Controls Bar -->
    <LinearLayout
        android:id="@+id/topControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- Top inset spacer: dynamically updated to systemBars.top -->
        <View
            android:id="@+id/statusInsetSpacerCamera"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_47sdp"
            android:paddingStart="@dimen/_13sdp"
            android:paddingEnd="@dimen/_13sdp">

            <ImageView
                android:id="@+id/btnCloseCamera"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_translucent"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/back"
                app:tint="@android:color/white" />

            <!-- Video Recording Timer Pill (Center) -->
            <LinearLayout
                android:id="@+id/layoutRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_timer_pill"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_7sdp"
                    android:layout_height="@dimen/_7sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:src="@drawable/circle_red" />

                <TextView
                    android:id="@+id/tvRecordingTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnArMaskToggle"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:layout_toStartOf="@id/btnFlashToggle"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/bg_circle_translucent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🎭"
                android:textSize="@dimen/_17ssp" />

            <ImageView
                android:id="@+id/btnFlashToggle"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_translucent"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_flash_off"
                android:contentDescription="Flash Toggle"
                app:tint="@android:color/white" />

        </RelativeLayout>

    </LinearLayout>

    <!-- 4. Bottom Viewfinder Controls (Shutter, Flip, Horizontal Carousel) -->
    <LinearLayout
        android:id="@+id/bottomCameraControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_27sdp">

        <!-- Swipe up for gallery indicator -->
        <LinearLayout
            android:id="@+id/btnSwipeUpGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/bg_timer_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_5sdp">

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_expand_less"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="Swipe up for gallery"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Horizontal Quick-Access Recent Media Strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentMediaHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_53sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_13sdp"
            android:paddingEnd="@dimen/_13sdp" />

        <!-- Slide Up To Lock Indicator (Hands-free Telegram parity) -->
        <LinearLayout
            android:id="@+id/layoutShutterLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/bg_timer_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivShutterLockIcon"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:src="@drawable/ic_lock"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvShutterLockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:text="Slide up to lock"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Zoom Level Pills (Telegram Parity: 0.5x, 1x, 2x, 5x) -->
        <LinearLayout
            android:id="@+id/layoutZoomPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_12sdp"
            android:background="@drawable/bg_timer_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/_3sdp">

            <TextView
                android:id="@+id/btnZoom05x"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:background="@drawable/bg_zoom_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="0.5x"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom1x"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:background="@drawable/bg_zoom_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1x"
                android:textColor="@android:color/black"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom2x"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:background="@drawable/bg_zoom_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="2x"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom5x"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:background="@drawable/bg_zoom_pill_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="5x"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shutter Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_27sdp"
            android:paddingEnd="@dimen/_27sdp">

            <!-- Open Full Gallery Button -->
            <ImageView
                android:id="@+id/btnOpenFullGallery"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/bg_circle_translucent"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_image"
                app:tint="@android:color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Large Concentric Dual-Action Shutter Button -->
            <FrameLayout
                android:id="@+id/shutterButton"
                android:layout_width="@dimen/_63sdp"
                android:layout_height="@dimen/_63sdp"
                android:background="@drawable/bg_shutter_outer"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/shutterInnerCircle"
                    android:layout_width="@dimen/_47sdp"
                    android:layout_height="@dimen/_47sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_inner" />

            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Lens Flip Button (Front / Rear) -->
            <ImageView
                android:id="@+id/btnFlipLens"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/bg_circle_translucent"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_flip_camera"
                app:tint="@android:color/white" />

        </LinearLayout>

        <!-- Camera Mode Switcher (PHOTO | VIDEO - Telegram Parity) -->
        <LinearLayout
            android:id="@+id/layoutCameraModes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_13sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/_12sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:text="PHOTO"
                android:textColor="#FFCC00"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/_12sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:text="VIDEO"
                android:textColor="#88FFFFFF"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- 5. Full-Screen In-App Media Gallery Overlay (Expands on swipe up / tap) -->
    <LinearLayout
        android:id="@+id/layoutFullGallery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F17"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Gallery Bar -->
        <LinearLayout
            android:id="@+id/layoutGalleryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B0F17"
            android:orientation="vertical">

            <!-- Inset spacer for gallery status bar -->
            <View
                android:id="@+id/statusInsetSpacerGallery"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_13sdp">

                <ImageView
                    android:id="@+id/btnBackFromGallery"
                    android:layout_width="@dimen/_37sdp"
                    android:layout_height="@dimen/_37sdp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/back"
                    app:tint="@android:color/white" />

                <!-- Album Dropdown Selector -->
                <LinearLayout
                    android:id="@+id/btnAlbumDropdown"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_37sdp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/btnBackFromGallery"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_7sdp"
                    android:paddingEnd="@dimen/_10sdp">

                    <TextView
                        android:id="@+id/tvCurrentAlbumName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Media"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/_17sdp"
                        android:layout_height="@dimen/_17sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Multi-Select Count Display -->
                <TextView
                    android:id="@+id/tvGallerySelectCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@color/veil_primary"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </RelativeLayout>

        </LinearLayout>

        <!-- 3-Column Media Grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFullGalleryGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/_67sdp" />

            <ProgressBar
                android:id="@+id/galleryLoaderProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/veil_primary"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutGalleryEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_20sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_53sdp"
                    android:layout_height="@dimen/_53sdp"
                    android:src="@drawable/ic_image"
                    app:tint="#66FFFFFF" />

                <TextView
                    android:id="@+id/tvGalleryEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="No photos or videos found"
                    android:textColor="#99FFFFFF"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Bottom Floating Action Bar for Selected Items -->
            <FrameLayout
                android:id="@+id/layoutFloatingSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:padding="@dimen/_17sdp"
                android:visibility="gone">

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/fabSendSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Send (1)"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/veil_primary"
                    app:icon="@drawable/ic_send"
                    app:iconTint="@android:color/white" />

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- 6. White Flash Scrim for Shutter Effect -->
    <View
        android:id="@+id/viewFlashScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone" />

</FrameLayout>
