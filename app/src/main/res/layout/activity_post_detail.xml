<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPostDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Top Reddit-Style Community & Thread Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_47sdp"
        android:background="@color/colorSurface"
        android:elevation="@dimen/_3sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10sdp">

        <ImageView
            android:id="@+id/btnBackPostDetail"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubveilHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v/veilboard"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThreadSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Community Discussion Thread"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnBookmarkPost"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmark"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_saved"
            app:tint="@color/colorTextPrimary" />

        <ImageView
            android:id="@+id/btnMorePostDetail"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/colorTextPrimary" />
    </LinearLayout>

    <!-- Scrollable Post + Sort Bar + Collapsible Threaded Comments -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPostDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_20sdp">

            <!-- Main Post Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPostHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/_13sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorOutline"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_13sdp">

                    <!-- Author Row -->
                    <LinearLayout
                        android:id="@+id/layoutAuthorHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ivPostDetailAvatar"
                            android:layout_width="@dimen/_33sdp"
                            android:layout_height="@dimen/_33sdp"
                            android:src="@drawable/ic_profile_placeholder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvPostDetailAuthor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@anonymous"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="@dimen/_12ssp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvOpBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:background="@drawable/bg_filter_chip"
                                    android:paddingHorizontal="@dimen/_5sdp"
                                    android:paddingVertical="@dimen/_2sdp"
                                    android:text="OP"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/_8ssp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvPostDetailMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Just now • CONFESSION"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDmAuthor"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_28sdp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:text="💬 DM OP"
                            android:textAllCaps="false"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_10ssp"
                            app:cornerRadius="@dimen/_8sdp"
                            app:strokeColor="@color/colorPrimary" />
                    </LinearLayout>

                    <!-- Post Content -->
                    <TextView
                        android:id="@+id/tvPostDetailContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:lineSpacingExtra="@dimen/_3sdp"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/_13ssp" />

                    <!-- Dynamic Attachments (Mosaic, Voice Waveform, Polls, Collab Chains) -->
                    <LinearLayout
                        android:id="@+id/layoutPostDetailAttachments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical" />

                    <!-- Awards Summary Strip -->
                    <LinearLayout
                        android:id="@+id/layoutAwardsStrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone" />

                    <!-- Reddit-Style Action Pill Bar (Upvote / Downvote / Comments / Award / Share) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Upvote / Score / Downvote Pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_8sdp">

                            <TextView
                                android:id="@+id/btnUpvotePost"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/_5sdp"
                                android:text="▲"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvVoteScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="@dimen/_5sdp"
                                android:text="0"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnDownvotePost"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/_5sdp"
                                android:text="▼"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Comments Pill -->
                        <LinearLayout
                            android:id="@+id/pillCommentsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_10sdp">

                            <TextView
                                android:id="@+id/tvCommentsPillText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💬 0"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Award / Tip VeilCoins Pill -->
                        <LinearLayout
                            android:id="@+id/btnAwardPost"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_10sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏆 Award"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Share / Quote Pill -->
                        <LinearLayout
                            android:id="@+id/btnSharePostDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:background="@drawable/bg_filter_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_10sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔄 Share"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reddit Comment Sort & Filter Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort by:"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutCommentSortChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipSortBest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_4sdp"
                            android:text="🔥 Best"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipSortNew"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:background="@drawable/bg_filter_chip"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_4sdp"
                            android:text="⚡ New"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipSortTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:background="@drawable/bg_filter_chip"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_4sdp"
                            android:text="🏆 Top"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipSortControversial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_filter_chip"
                            android:paddingHorizontal="@dimen/_8sdp"
                            android:paddingVertical="@dimen/_4sdp"
                            android:text="⚔️ Controversial"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Collapsible Threaded Comments Container -->
            <LinearLayout
                android:id="@+id/layoutThreadedCommentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyThreadState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/_27sdp"
                android:text="No comments yet. Start the anonymous discussion below!"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_12ssp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Reply Context Banner (when replying to a specific comment) -->
    <LinearLayout
        android:id="@+id/layoutReplyingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_5sdp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReplyingToLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Replying to @anonymous"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelReplyTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_3sdp"
            android:text="✕ Cancel"
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Sticky Comment Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="@dimen/_7sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_7sdp">

        <ImageView
            android:id="@+id/btnVoiceComment"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Reply"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_mic"
            app:tint="@color/colorPrimary" />

        <EditText
            android:id="@+id/etThreadCommentInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_7sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:hint="Add an anonymous comment..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="@dimen/_33sdp"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextSecondary"
            android:textSize="@dimen/_12ssp" />

        <ImageView
            android:id="@+id/btnSendThreadComment"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="@color/colorPrimary"
            android:contentDescription="Send Comment"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_send"
            app:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
