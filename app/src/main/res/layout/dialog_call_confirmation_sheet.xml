<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_persona_drag_handle" />

    <!-- Avatar Container with Call Badge -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivCallConfirmAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:civ_border_width="2.5dp"
            app:civ_border_color="@color/colorPrimary" />

        <ImageView
            android:id="@+id/ivCallConfirmBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_chat_call_btn_neutral"
            android:padding="5dp"
            android:src="@drawable/ic_call"
            app:tint="@color/colorPrimary" />
    </FrameLayout>

    <!-- Contact / Group Name -->
    <TextView
        android:id="@+id/tvCallConfirmName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-medium"
        android:text="Contact Name"
        android:textColor="@color/textPrimary"
        android:textSize="19sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:singleLine="true" />

    <!-- Security & Encryption Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="End-to-End Encrypted \u2022 P2P"
            android:textColor="@color/colorPrimary"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Segmented Call Type Switcher (Voice Call vs Video Call) -->
    <LinearLayout
        android:id="@+id/layoutSegmentContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_call_confirm_segmented_container"
        android:orientation="horizontal"
        android:padding="3dp">

        <!-- Voice Segment -->
        <LinearLayout
            android:id="@+id/btnSegmentAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_call_confirm_segment_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/ivSegmentAudio"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvSegmentAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Voice Call"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Video Segment -->
        <LinearLayout
            android:id="@+id/btnSegmentVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/ivSegmentVideo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_video"
                app:tint="@color/textSecondary" />

            <TextView
                android:id="@+id/tvSegmentVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Video Call"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Context Hint / Direct Channel info -->
    <TextView
        android:id="@+id/tvCallConfirmHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:text="Direct peer-to-peer WebRTC connection. Zero servers in between."
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Action Buttons (Cancel / Start Call) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Cancel Button -->
        <TextView
            android:id="@+id/btnCallConfirmCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_call_confirm_btn_cancel"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Start Call Button -->
        <LinearLayout
            android:id="@+id/btnCallConfirmStart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_call_confirm_btn_start"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCallConfirmActionIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvCallConfirmActionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Voice Call"
                android:textColor="@android:color/white"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
