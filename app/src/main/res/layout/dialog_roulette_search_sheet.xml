<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_24sdp"
    android:paddingEnd="@dimen/_24sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_28sdp"
    android:gravity="center_horizontal">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_marginBottom="@dimen/_20sdp" />

    <ProgressBar
        android:id="@+id/pbRouletteRadar"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_60sdp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimary"
        android:layout_marginBottom="@dimen/_16sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blind Roulette Match"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_19ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_6sdp" />

    <TextView
        android:id="@+id/tvRouletteStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a topic to chat with someone new:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_14ssp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_16sdp" />

    <!-- Mood Tags -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_20sdp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodAny"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Any Mood"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodConfess"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deep Confessions" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodCyber"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tech &amp; Crypto" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodChill"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Casual Chill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodDare"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Truth or Dare" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 3-Minute Speed Timer Indicator -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3-Minute Speed Match • Ephemeral 180s Vanish Timer"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_12ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_20sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartMatch"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:text="Start Blind Matchmaking"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cornerRadius="@dimen/_12sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelRoulette"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:text="Cancel"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>
