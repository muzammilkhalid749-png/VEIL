<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:gravity="center_horizontal">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@color/colorOutline"
        android:layout_marginBottom="20dp" />

    <ProgressBar
        android:id="@+id/pbRouletteRadar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎲 1:1 Blind Roulette Match"
        android:textColor="@color/textPrimary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvRouletteStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a mood tag to match with an anonymous mesh partner:"
        android:textColor="@color/textSecondary"
        android:textSize="13.5sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Mood Tags -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodAny"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎭 Any Mood"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodConfess"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤫 Deep Confessions" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodCyber"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Tech &amp; Crypto" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodChill"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☕ Casual Chill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMoodDare"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎲 Truth or Dare" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 3-Minute Speed Timer Indicator -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ 3-Minute Speed Match • Ephemeral 180s Vanish Timer"
        android:textColor="@color/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartMatch"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Start Blind Matchmaking"
        android:layout_marginBottom="10dp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelRoulette"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel"
        app:cornerRadius="12dp" />

</LinearLayout>
