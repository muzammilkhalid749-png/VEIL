<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_18sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_18sdp"
    android:paddingBottom="@dimen/_22sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Delete Message"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_16ssp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:text="Select deletion scope for this message:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp" />

    <!-- Option 1: Delete For Me -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDeleteForMe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_delete"
                app:tint="@color/textSecondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Delete for me"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Removes this message from your device"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/textTertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Option 2: Delete For Everyone -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDeleteForEveryone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_13sdp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Delete for everyone"
                    android:textColor="#EF4444"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Delete this message for everyone in the chat"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/textTertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cancel button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelDelete"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:fontFamily="sans-serif-medium"
        android:text="Cancel"
        android:textSize="@dimen/_12ssp"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>
