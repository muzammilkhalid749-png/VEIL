<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_17sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_17ssp"
        android:fontFamily="sans-serif-medium" />

    <FrameLayout
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_17sdp"
        android:layout_marginBottom="@dimen/_13sdp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/editAvatarImage"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:src="@drawable/ic_profile_placeholder"
            app:civ_border_color="@color/colorPrimary"
            app:civ_border_width="@dimen/_2sdp" />

        <ImageView
            android:id="@+id/btnChangeAvatar"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_persona_avatar_circle"
            android:backgroundTint="@color/colorPrimary"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_camera"
            app:tint="@android:color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnRemoveAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:text="Remove Photo"
        android:textColor="@color/colorError"
        android:textSize="@dimen/_11ssp"
        android:fontFamily="sans-serif-medium"
        android:padding="@dimen/_5sdp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISPLAY NAME (@USERNAME)"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_9ssp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_5sdp" />

    <EditText
        android:id="@+id/editDisplayNameInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/bg_search_input"
        android:hint="Enter your @username"
        android:inputType="textPersonName"
        android:paddingStart="@dimen/_13sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:textSize="@dimen/_12ssp" />

    <TextView
        android:id="@+id/tvUsernameAvailability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_3sdp"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_10ssp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:text="BIO / STATUS"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_9ssp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_5sdp" />

    <EditText
        android:id="@+id/editBioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_40sdp"
        android:background="@drawable/bg_search_input"
        android:hint="Tell the world something about yourself"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:textSize="@dimen/_12ssp" />

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveProfile"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:backgroundTint="@color/colorPrimary"
        android:text="Save Changes"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_13ssp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>