<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_20ssp"
        android:fontFamily="sans-serif-medium" />

    <FrameLayout
        android:layout_width="@dimen/_96sdp"
        android:layout_height="@dimen/_96sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_16sdp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/editAvatarImage"
            android:layout_width="@dimen/_96sdp"
            android:layout_height="@dimen/_96sdp"
            android:src="@drawable/ic_profile_placeholder"
            app:civ_border_color="@color/colorPrimary"
            app:civ_border_width="@dimen/_2sdp" />

        <ImageView
            android:id="@+id/btnChangeAvatar"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_persona_avatar_circle"
            android:backgroundTint="@color/colorPrimary"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_camera"
            app:tint="@android:color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnRemoveAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:text="Remove Photo"
        android:textColor="@color/colorError"
        android:textSize="@dimen/_13ssp"
        android:fontFamily="sans-serif-medium"
        android:padding="@dimen/_6sdp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISPLAY NAME (@USERNAME)"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_11ssp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_6sdp" />

    <EditText
        android:id="@+id/editDisplayNameInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:background="@drawable/bg_search_input"
        android:hint="Enter your @username"
        android:inputType="textPersonName"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:textSize="@dimen/_14ssp" />

    <TextView
        android:id="@+id/tvUsernameAvailability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_4sdp"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_12ssp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:text="BIO / STATUS"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_11ssp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:layout_marginStart="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_6sdp" />

    <EditText
        android:id="@+id/editBioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_48sdp"
        android:background="@drawable/bg_search_input"
        android:hint="Tell the world something about yourself"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:paddingStart="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:textSize="@dimen/_14ssp" />

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveProfile"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:backgroundTint="@color/colorPrimary"
        android:text="Save Changes"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_15ssp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        app:cornerRadius="@dimen/_14sdp" />

</LinearLayout>