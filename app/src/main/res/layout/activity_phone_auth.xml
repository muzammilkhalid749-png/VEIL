<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="@dimen/_33sdp"
        android:layout_height="@dimen/_33sdp"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="@dimen/_7sdp"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:tint="@color/textPrimary" />

    <!-- Main Scrollable Container (Keyboard and screen-size adaptive) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/_367sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingTop="@dimen/_40sdp"
            android:paddingBottom="@dimen/_20sdp">

            <!-- App Logo Header -->
            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginBottom="@dimen/_13sdp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/veil_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="@string/welcome_to_veil"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_23sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/tagline"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_12ssp" />

            <!-- Phone Input Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_7sdp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/enter_phone_number"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <!-- Country Picker and Phone Input Container -->
            <LinearLayout
                android:id="@+id/countryPickerContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_47sdp"
                android:background="@drawable/input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12sdp">

                <TextView
                    android:id="@+id/flagEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:text="🇺🇸"
                    android:textSize="@dimen/_15ssp" />

                <TextView
                    android:id="@+id/countryCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="+1"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:contentDescription="Select Country"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/textSecondary" />

                <View
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:background="@color/colorOutline" />

                <!-- Phone Number Edit -->
                <EditText
                    android:id="@+id/phoneNumberEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="phone"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Phone number"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary"
                    android:textSize="@dimen/_13ssp" />

            </LinearLayout>

            <TextView
                android:id="@+id/exampleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="Example: XXX-XXXXXXX"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_10ssp"
                android:visibility="gone" />

            <!-- Terms Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:layout_marginBottom="@dimen/_17sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="@string/terms_agreement"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_10ssp" />

            <!-- Primary Continue Button with Centered In-Button Spinner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueButton"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:letterSpacing="0.01"
                    android:text="@string/continue_text"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/_12sdp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_15sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_weight="1"
                    android:background="@color/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/or_text"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_weight="1"
                    android:background="@color/colorOutline" />
            </LinearLayout>

            <!-- Anonymous Mode Join Button with Centered In-Button Spinner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/anonymousJoinButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:letterSpacing="0.01"
                    android:text="@string/join_anonymously"
                    android:textAllCaps="false"
                    android:textColor="@color/veil_accent"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/_12sdp"
                    app:strokeColor="@color/veil_accent"
                    app:strokeWidth="@dimen/_1sdp" />

                <ProgressBar
                    android:id="@+id/anonymousProgressBar"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/veil_accent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Restore Account Link -->
            <TextView
                android:id="@+id/restoreAccountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="@dimen/_7sdp"
                android:text="Restore Anonymous Account"
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_11ssp" />

            <!-- Privacy Shield Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:drawableStart="@drawable/ic_shield"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/privacy_priority"
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_10ssp"
                app:drawableTint="@color/veil_accent" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
