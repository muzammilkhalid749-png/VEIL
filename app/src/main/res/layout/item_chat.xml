<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_63sdp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/_13sdp"
    android:paddingEnd="@dimen/_13sdp"
    android:background="?attr/selectableItemBackground">

    <!-- Avatar Container -->
    <RelativeLayout
        android:layout_width="@dimen/_43sdp"
        android:layout_height="@dimen/_43sdp"
        android:layout_marginEnd="@dimen/_12sdp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/_43sdp"
            android:layout_height="@dimen/_43sdp"
            android:src="@drawable/ic_person"
            app:civ_border_width="@dimen/_1sdp"
            app:civ_border_color="@color/colorOutline" />

        <!-- Online Indicator -->
        <View
            android:id="@+id/onlineIndicator"
            android:layout_width="@dimen/_11sdp"
            android:layout_height="@dimen/_11sdp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/online_indicator"
            android:visibility="gone" />

        <!-- Vanish Mode Mini Badge on Avatar -->
        <ImageView
            android:id="@+id/ivVanishAvatarBadge"
            android:layout_width="@dimen/_13sdp"
            android:layout_height="@dimen/_13sdp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/circle_background"
            android:padding="@dimen/_2sdp"
            android:src="@drawable/ic_timer"
            app:tint="@color/colorPrimary"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- Chat Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chat Name"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_13ssp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/ivChatLocked"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:src="@drawable/ic_lock"
                app:tint="@color/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- WhatsApp status_indicator (Clock / 1 Tick / 2 Grey Ticks / 2 Blue Ticks) -->
            <ImageView
                android:id="@+id/lastMessageStatus"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:src="@drawable/ic_check"
                app:tint="@color/textSecondary"
                android:visibility="gone" />

            <!-- WhatsApp message_type_indicator (Voice/Photo/Video/Doc/Poll/Blink icon) -->
            <ImageView
                android:id="@+id/lastMessageTypeIcon"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:src="@drawable/ic_mic"
                app:tint="@color/textSecondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lastMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last message preview..."
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_12ssp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right Side Info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="@dimen/_7sdp">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="@color/textSecondary"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/_10ssp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/_4sdp">

            <ImageView
                android:id="@+id/ivMuted"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:src="@drawable/ic_chat_mute"
                app:tint="@color/textSecondary"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivPinned"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:src="@drawable/ic_chat_pin"
                app:tint="@color/veil_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/unreadCount"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_17sdp"
                android:minWidth="@dimen/_17sdp"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:gravity="center"
                android:text="1"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="@dimen/_9ssp"
                android:background="@drawable/unread_badge"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
