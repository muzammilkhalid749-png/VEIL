<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mediaEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1017">

    <ja.burhanrashid52.photoeditor.PhotoEditorView
        android:id="@+id/photoEditorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/videoTrimmerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/videoTrimmerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Standard Mid Play/Pause Button on Video Player -->
        <ImageView
            android:id="@+id/btnMidPlayPause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_translucent"
            android:padding="16dp"
            android:src="@drawable/ic_play_arrow"
            app:tint="@android:color/white"
            android:elevation="8dp" />
    </FrameLayout>

    <!-- Unified Studio Top Header Bar (Close Button + Batch Pill + Scrollable Tool & Chip Bar) -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="12dp"
        android:background="#B30B1017"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />

        <!-- Multi-media selection counter pill (1 / N) -->
        <TextView
            android:id="@+id/tvEditBatchCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="1 / 1"
            android:textColor="@android:color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/topToolbarScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:scrollbars="none"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/topToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/btnUndo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_undo"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnCrop"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_crop"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnEmoji"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_emoji"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnText"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_text"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnDraw"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_draw"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <!-- Toolbar GIF Mode Toggle Icon (Select/Unselect) -->
                <ImageView
                    android:id="@+id/btnToolbarGifMode"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_gif_mode"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- TOP VIDEO FILMSTRIP TRIMMER BAR (Unified WhatsApp / Telegram Design) -->
    <LinearLayout
        android:id="@+id/videoTrimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="#D90B1017"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Controls Row: Play/Pause Toggle & GIF Loop Toggle (Deprecated in favor of Mid Button & Toolbar GIF) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnVideoPlayPauseToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏸ Pause"
                android:textColor="@android:color/white"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_filter_chip" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnVideoGifModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Video Mode"
                android:textColor="@android:color/white"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_filter_chip" />
        </LinearLayout>

        <!-- Unified Filmstrip Thumbnail Strip & Draggable Selection Handles -->
        <com.m3.veil.ui.views.VeilVideoTrimmerFilmstripView
            android:id="@+id/videoFilmstripTrimmer"
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <!-- Info / Timestamps Row below Filmstrip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp">

            <TextView
                android:id="@+id/tvTrimStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/tvTrimDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Trim Video"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvTrimEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>

    <!-- WhatsApp/Telegram Multi-Media Thumbnail Strip for Selected Photos & Videos -->
    <HorizontalScrollView
        android:id="@+id/editBatchThumbnailScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="#CC0B1017"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:id="@+id/editBatchThumbnailStrip"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- WhatsApp Two-Row Bottom Composer (Caption Pill Row + Status/Recipient & Green Send FAB Row) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D90B1017"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Row 1: Dark Rounded Caption Pill ([🖼+] Add a caption... [@] [①]) -->
        <LinearLayout
            android:id="@+id/captionPillWrap"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_media_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/btnAddMoreMedia"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_image"
                app:tint="#CFD8DC" />

            <EditText
                android:id="@+id/captionEditText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Add a caption..."
                android:singleLine="true"
                android:textColorHint="#99FFFFFF"
                android:textColor="@android:color/white"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/btnMentionTag"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@"
                android:textColor="#CFD8DC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnViewOnce"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvViewOnceBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_view_once_ring"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#00A884"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: Left Status/Recipient Pill ([◎ Status (Contacts)]) + Right Green Circular Send FAB (➤ + Progress) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/recipientStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_media_glass_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivRecipientStatusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_status_ring"
                    app:tint="#CFD8DC" />

                <TextView
                    android:id="@+id/tvRecipientStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Status (Contacts)"
                    android:textColor="@android:color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/sendButtonContainer"
                android:layout_width="48dp"
                android:layout_height="48dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:backgroundTint="#25D366"
                    app:tint="#0B141A"
                    app:fabCustomSize="48dp"
                    app:maxImageSize="22dp"
                    app:elevation="4dp" />

                <ProgressBar
                    android:id="@+id/sendProgressSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#0B141A"
                    android:elevation="8dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Frosted-Glass Media Processing Overlay Card -->
    <LinearLayout
        android:id="@+id/mediaProcessingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="26dp"
        android:paddingVertical="20dp"
        android:background="@drawable/bg_done_button"
        android:elevation="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/mediaProcessingSpinner"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:indeterminateTint="#25D366"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvMediaProcessingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing media..."
            android:textColor="@android:color/white"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- DEDICATED DRAWING HEADER BAR (Safely inset below Status Bar) -->
    <LinearLayout
        android:id="@+id/drawingHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#D90B1017"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Done"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_done_button" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/drawingOptionsBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnDrawUndo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_undo"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />
    </LinearLayout>

    <com.m3.veil.ui.chat.ColorPickerView
        android:id="@+id/colorPickerView"
        android:layout_width="24dp"
        android:layout_height="250dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/textOptionsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_done_button"
        android:visibility="gone"
        android:paddingVertical="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <!-- Fonts will go here -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aa"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
