<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mediaEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1017">

    <ja.burhanrashid52.photoeditor.PhotoEditorView
        android:id="@+id/photoEditorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/videoTrimmerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/videoTrimmerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Standard Mid Play/Pause Button on Video Player -->
        <ImageView
            android:id="@+id/btnMidPlayPause"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_translucent"
            android:padding="@dimen/_13sdp"
            android:src="@drawable/ic_play_arrow"
            app:tint="@android:color/white"
            android:elevation="@dimen/_7sdp" />
    </FrameLayout>

    <!-- Unified Studio Top Header Bar (Close Button + Batch Pill + Scrollable Tool & Chip Bar) -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:background="#B30B1017"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />

        <!-- Multi-media selection counter pill (1 / N) -->
        <TextView
            android:id="@+id/tvEditBatchCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="@dimen/_9sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:text="1 / 1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/topToolbarScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_7sdp"
            android:scrollbars="none"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/topToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/btnDeleteCurrentMedia"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_delete"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white"
                    android:visibility="gone"
                    android:contentDescription="Remove media" />

                <ImageView
                    android:id="@+id/btnUndo"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_undo"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnCrop"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_crop"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnEmoji"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_emoji"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnText"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_text"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/btnDraw"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_draw"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white" />

                <!-- Toolbar GIF Mode Toggle Icon (Select/Unselect) -->
                <ImageView
                    android:id="@+id/btnToolbarGifMode"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_gif_mode"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="@android:color/white"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- TOP VIDEO FILMSTRIP TRIMMER BAR (Unified WhatsApp / Telegram Design) -->
    <LinearLayout
        android:id="@+id/videoTrimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_7sdp"
        android:background="#D90B1017"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Controls Row: Play/Pause Toggle & GIF Loop Toggle (Deprecated in favor of Mid Button & Toolbar GIF) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/_5sdp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnVideoPlayPauseToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏸ Pause"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_3sdp"
                android:background="@drawable/bg_filter_chip" />

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnVideoGifModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Video Mode"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_3sdp"
                android:background="@drawable/bg_filter_chip" />
        </LinearLayout>

        <!-- Unified Filmstrip Thumbnail Strip & Draggable Selection Handles -->
        <com.m3.veil.ui.views.VeilVideoTrimmerFilmstripView
            android:id="@+id/videoFilmstripTrimmer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp" />

        <!-- Info / Timestamps Row below Filmstrip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/_4sdp">

            <TextView
                android:id="@+id/tvTrimStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/tvTrimDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Trim Video"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvTrimEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_10ssp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>

    <!-- WhatsApp/Telegram Multi-Media Thumbnail Strip for Selected Photos & Videos -->
    <HorizontalScrollView
        android:id="@+id/editBatchThumbnailScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingVertical="@dimen/_5sdp"
        android:background="#CC0B1017"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:id="@+id/editBatchThumbnailStrip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_50sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- WhatsApp Two-Row Bottom Composer (Caption Pill Row + Status/Recipient & Green Send FAB Row) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D90B1017"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Row 1: Dark Rounded Caption Pill ([🖼+] Add a caption... [@] [①]) -->
        <LinearLayout
            android:id="@+id/captionPillWrap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_media_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_8sdp">

            <ImageView
                android:id="@+id/btnAddMoreMedia"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_image"
                app:tint="#CFD8DC" />

            <EditText
                android:id="@+id/captionEditText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@null"
                android:hint="Add a caption..."
                android:singleLine="true"
                android:textColorHint="#99FFFFFF"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/btnMentionTag"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:gravity="center"
                android:text="@"
                android:textColor="#CFD8DC"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnViewOnce"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvViewOnceBadge"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_view_once_ring"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#00A884"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: Left Status/Recipient Pill ([◎ Status (Contacts)]) + Right Green Circular Send FAB (➤ + Progress) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/recipientStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:background="@drawable/bg_media_glass_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivRecipientStatusIcon"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_status_ring"
                    app:tint="#CFD8DC" />

                <TextView
                    android:id="@+id/tvRecipientStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:text="Status (Contacts)"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/sendButtonContainer"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:backgroundTint="#25D366"
                    app:tint="#0B141A"
                    app:fabCustomSize="@dimen/_40sdp"
                    app:maxImageSize="@dimen/_18sdp"
                    app:elevation="@dimen/_3sdp" />

                <ProgressBar
                    android:id="@+id/sendProgressSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#0B141A"
                    android:elevation="@dimen/_7sdp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Frosted-Glass Media Processing Overlay Card -->
    <LinearLayout
        android:id="@+id/mediaProcessingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_22sdp"
        android:paddingVertical="@dimen/_17sdp"
        android:background="@drawable/bg_done_button"
        android:elevation="@dimen/_12sdp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/mediaProcessingSpinner"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:indeterminateTint="#25D366"
            android:layout_marginBottom="@dimen/_8sdp" />

        <TextView
            android:id="@+id/tvMediaProcessingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing media..."
            android:textColor="@android:color/white"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- DEDICATED DRAWING HEADER BAR (Safely inset below Status Bar) -->
    <LinearLayout
        android:id="@+id/drawingHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:background="#D90B1017"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_30sdp"
            android:text="Done"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_13sdp"
            android:background="@drawable/bg_done_button" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/drawingOptionsBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnDrawUndo"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_undo"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />
    </LinearLayout>

    <com.m3.veil.ui.chat.ColorPickerView
        android:id="@+id/colorPickerView"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_208sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:visibility="gone"
        android:elevation="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/textOptionsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_done_button"
        android:visibility="gone"
        android:paddingVertical="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_27sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_13sdp">
            <!-- Fonts will go here -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aa"
                android:textSize="@dimen/_15ssp"
                android:textColor="@android:color/white"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_7sdp" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
