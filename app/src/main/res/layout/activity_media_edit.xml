<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ja.burhanrashid52.photoeditor.PhotoEditorView
        android:id="@+id/photoEditorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BASE STATE UI -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:gravity="end|center_vertical"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:padding="8dp"
            android:src="@drawable/ic_undo"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/btnCrop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:padding="8dp"
            android:src="@drawable/ic_crop"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:padding="8dp"
            android:src="@drawable/ic_emoji"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/btnText"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:padding="8dp"
            android:src="@drawable/ic_text"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/btnDraw"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_draw"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@android:color/white" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_circle_translucent"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Multi-media selection counter pill (1 / N) -->
    <TextView
        android:id="@+id/tvEditBatchCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_filter_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="1 / 1"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toEndOf="@id/btnClose" />

    <!-- VIDEO TRIMMER BAR -->
    <LinearLayout
        android:id="@+id/videoTrimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/editBatchThumbnailScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrimStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/tvTrimDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Trim Video"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvTrimEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/videoRangeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary"
            app:trackColorInactive="#66FFFFFF"
            app:thumbElevation="2dp"
            app:trackHeight="4dp" />
    </LinearLayout>

    <!-- WhatsApp/Telegram Multi-Media Thumbnail Strip for Selected Photos & Videos -->
    <HorizontalScrollView
        android:id="@+id/editBatchThumbnailScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:id="@+id/editBatchThumbnailStrip"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- WhatsApp Two-Row Bottom Composer (status_3cb0513d.jpg: Caption Pill Row + Status/Recipient & Green Send FAB Row) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Row 1: Dark Rounded Caption Pill ([🖼+] Add a caption... [@] [①]) -->
        <LinearLayout
            android:id="@+id/captionPillWrap"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_media_glass_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/btnAddMoreMedia"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_image"
                app:tint="#CFD8DC" />

            <EditText
                android:id="@+id/captionEditText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Add a caption..."
                android:singleLine="true"
                android:textColorHint="#99FFFFFF"
                android:textColor="@android:color/white"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/btnMentionTag"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="@"
                android:textColor="#CFD8DC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnViewOnce"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvViewOnceBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_view_once_ring"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#00A884"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: Left Status/Recipient Pill ([◎ Status (Contacts)]) + Right Green Circular Send FAB (➤) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/recipientStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_media_glass_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivRecipientStatusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_status_ring"
                    app:tint="#CFD8DC" />

                <TextView
                    android:id="@+id/tvRecipientStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Status (Contacts)"
                    android:textColor="@android:color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_send"
                app:backgroundTint="#25D366"
                app:tint="#0B141A"
                app:fabCustomSize="48dp"
                app:maxImageSize="22dp"
                app:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- DRAWING & TEXT STATE UI OVERLAYS -->
    <TextView
        android:id="@+id/btnDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Done"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_done_button"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.m3.veil.ui.chat.ColorPickerView
        android:id="@+id/colorPickerView"
        android:layout_width="24dp"
        android:layout_height="250dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/drawingOptionsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/bg_done_button"
        android:visibility="gone"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_draw"
            app:tint="@android:color/white" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/textOptionsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_done_button"
        android:visibility="gone"
        android:paddingVertical="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            <!-- Fonts will go here -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aa"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
