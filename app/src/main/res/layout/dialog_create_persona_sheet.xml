<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_17sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <!-- Header Row -->
    <TextView
        android:id="@+id/tvCreatePersonaTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="New Persona"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_16ssp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:text="Create an isolated profile with its own unique @username and chats."
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_367sdp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Live Avatar & Name Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_13sdp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_10sdp">

                <FrameLayout
                    android:layout_width="@dimen/_37sdp"
                    android:layout_height="@dimen/_37sdp"
                    android:layout_marginEnd="@dimen/_10sdp">

                    <View
                        android:id="@+id/vPreviewAvatarBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_persona_avatar_circle" />

                    <TextView
                        android:id="@+id/tvPreviewMonogram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:text="P"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_15ssp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPreviewDisplayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Persona Name"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_13ssp" />

                    <TextView
                        android:id="@+id/tvPreviewUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@persona"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreviewMoodBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_persona_active_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/_7sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingEnd="@dimen/_7sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:text="🎭 Anonymous"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <!-- Display Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_3sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Display Name"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp" />

            <EditText
                android:id="@+id/etPersonaDisplayName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/bg_search_input"
                android:fontFamily="sans-serif"
                android:hint="e.g. Alex, Cyber Knight, Ghost"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textTertiary"
                android:textSize="@dimen/_12ssp" />

            <!-- Username Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_3sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Username"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:background="@drawable/bg_search_input">

                <TextView
                    android:id="@+id/tvAtSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_12sdp"
                    android:text="@"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_13ssp" />

                <EditText
                    android:id="@+id/etPersonaUsername"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/tvAtSymbol"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="username"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:maxLines="1"
                    android:paddingStart="@dimen/_2sdp"
                    android:paddingEnd="@dimen/_33sdp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textTertiary"
                    android:textSize="@dimen/_12ssp" />

                <ProgressBar
                    android:id="@+id/pbCheckingUsername"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Username Availability Status Text -->
            <TextView
                android:id="@+id/tvUsernameStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:fontFamily="sans-serif"
                android:text="Enter at least 3 characters"
                android:textColor="@color/textTertiary"
                android:textSize="@dimen/_10ssp" />

            <!-- Bio / About (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_3sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Bio (Optional)"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp" />

            <EditText
                android:id="@+id/etPersonaBio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/bg_search_input"
                android:fontFamily="sans-serif"
                android:hint="e.g. Encrypted by default."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textTertiary"
                android:textSize="@dimen/_11ssp" />

            <!-- Mood Badge Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Select Mood Badge"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_12sdp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llMoodChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Accent Color Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Theme Accent"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp" />

            <LinearLayout
                android:id="@+id/llColorDotsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_13sdp"
                android:orientation="horizontal" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Create Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitCreatePersona"
        style="@style/Widget.Material3.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:enabled="false"
        android:fontFamily="sans-serif-medium"
        android:text="Create Persona"
        android:textSize="@dimen/_12ssp"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>
