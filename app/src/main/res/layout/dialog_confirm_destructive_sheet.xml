<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_24sdp"
    android:paddingEnd="@dimen/_24sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_12sdp">

        <ImageView
            android:id="@+id/ivDestructiveIcon"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_delete"
            android:tint="#EF4444"
            android:background="@drawable/bg_swatch_rose"
            android:layout_marginEnd="@dimen/_14sdp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDestructiveTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Chat?"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_19ssp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This action cannot be undone"
                android:textColor="#EF4444"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/_2sdp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDestructiveMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to clear all messages in this conversation?"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_14ssp"
        android:lineSpacingExtra="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_14sdp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDeleteForPeer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Also delete for the other person (both devices)"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_14ssp"
        android:checked="true"
        android:layout_marginBottom="@dimen/_14sdp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDestructiveConfirm"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:text="Confirm &amp; Delete"
        android:textColor="#FFFFFF"
        app:backgroundTint="#EF4444"
        app:cornerRadius="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDestructiveCancel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:text="Cancel"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>
