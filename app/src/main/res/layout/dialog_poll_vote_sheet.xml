<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@color/colorOutline"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/tvPollSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊 Anonymous Community Poll"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvPollSheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap any option to cast your zero-trace anonymous vote:"
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Container where option cards are inflated -->
    <LinearLayout
        android:id="@+id/pollOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenComments"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="💬 View Anonymous Discussion"
        app:cornerRadius="12dp" />

</LinearLayout>
