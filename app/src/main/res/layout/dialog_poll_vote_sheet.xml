<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_20sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_15sdp" />

    <TextView
        android:id="@+id/tvPollSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Community Poll"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_15ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_5sdp" />

    <TextView
        android:id="@+id/tvPollSheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap any option to cast your zero-trace anonymous vote:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp"
        android:layout_marginBottom="@dimen/_13sdp" />

    <!-- Container where option cards are inflated -->
    <LinearLayout
        android:id="@+id/pollOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/_13sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenComments"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:text="View Anonymous Discussion"
        app:icon="@drawable/ic_comment"
        app:iconGravity="textStart"
        app:cornerRadius="@dimen/_10sdp" />

</LinearLayout>
