<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:maxWidth="@dimen/_367sdp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_23sdp"
        android:paddingVertical="@dimen/_10sdp">

        <!-- Halo + Floating Micro-Pills Container -->
        <FrameLayout
            android:layout_width="@dimen/_242sdp"
            android:layout_height="@dimen/_242sdp"
            android:layout_marginBottom="@dimen/_23sdp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Concentric Halo & Main Vector Artwork -->
            <ImageView
                android:id="@+id/onboardingImage"
                android:layout_width="@dimen/_225sdp"
                android:layout_height="@dimen/_225sdp"
                android:layout_gravity="center"
                android:contentDescription="Onboarding Illustration"
                android:scaleType="fitCenter" />

            <!-- Top-Right Floating Micro-Pill (AES-256 / Serverless P2P / Anonymous) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pillTopRightCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_47sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_15sdp"
                app:cardElevation="@dimen/_5sdp"
                app:strokeColor="#EEF2FA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:id="@+id/pillTopRightText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="Encrypted"
                    android:textColor="#1F2433"
                    android:textSize="@dimen/_10ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom-Left Floating Micro-Pill (Local Key on Slide 1) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pillBottomLeftCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_65sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_15sdp"
                app:cardElevation="@dimen/_5sdp"
                app:strokeColor="#EEF2FA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:id="@+id/pillBottomLeftText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="Local Key"
                    android:textColor="#1F2433"
                    android:textSize="@dimen/_10ssp" />
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_12sdp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:lineSpacingExtra="@dimen/_3sdp"
            android:text="Private &amp; Secure\nMessaging"
            android:textColor="#161925"
            android:textSize="@dimen/_22ssp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/onboardingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_13sdp"
            android:text="All messages are fully encrypted on-device. Only you and your recipient hold the keys."
            android:textColor="#5A6175"
            android:textSize="@dimen/_13ssp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>