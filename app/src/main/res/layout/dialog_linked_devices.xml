<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_17sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingBottom="@dimen/_27sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Linked Devices (VEIL Web)"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_17ssp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:text="Link your desktop browser to use VEIL on your computer"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp" />

    <!-- Link a Device Primary CTA Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:text="Link a Device (Scan QR Code)"
        android:textAllCaps="false"
        android:textSize="@dimen/_13ssp"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="@dimen/_13sdp"
        app:icon="@drawable/ic_devices"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        android:backgroundTint="@color/colorPrimary" />

    <!-- Manual Pairing Code Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_13sdp"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/colorOutline"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_13sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAIRING CODE / PEER ID"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_9ssp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:layout_marginBottom="@dimen/_8sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etPairingCode"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="e.g. sess_uuid or veil_web_..."
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="monospace"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectCode"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:text="Link"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="@dimen/_10sdp"
                    android:backgroundTint="@color/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Active Sessions Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVE SESSIONS"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_9ssp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_7sdp" />

    <LinearLayout
        android:id="@+id/containerLinkedDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Active Linked Device Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/_13sdp"
            app:cardElevation="0dp"
            app:strokeWidth="@dimen/_1sdp"
            app:strokeColor="@color/colorOutline"
            app:cardBackgroundColor="@color/colorSurfaceContainerLow">

            <LinearLayout
                android:id="@+id/cardActiveWebDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_13sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/bg_persona_avatar_circle"
                    android:backgroundTint="@color/colorSurfaceVariant">

                    <ImageView
                        android:layout_width="@dimen/_17sdp"
                        android:layout_height="@dimen/_17sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_devices"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeviceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No desktop companion linked"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_13ssp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvDeviceSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="Scan QR on web.veil.network to link"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnlinkDevice"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlink"
                    android:textColor="@color/colorError"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>