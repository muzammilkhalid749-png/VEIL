<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="@dimen/_12sdp"
    android:layout_marginTop="@dimen/_8sdp"
    android:layout_marginBottom="@dimen/_16sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_date_header_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp">

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:src="@drawable/ic_lock"
            app:tint="@color/message_text_secondary" />

        <TextView
            android:layout_width="@dimen/_240sdp"
            android:layout_height="wrap_content"
            android:text="Messages and calls are end-to-end encrypted. No one outside of this chat, not even VEIL, can read or listen to them."
            android:textAlignment="center"
            android:textColor="@color/message_text_secondary"
            android:textSize="@dimen/_11ssp" />

    </LinearLayout>

</LinearLayout>
