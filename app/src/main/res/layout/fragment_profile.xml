<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:id="@+id/profileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_96sdp">

            <!-- Top Header Bar: Title & Security/Mesh Status Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/_12sdp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Profile"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_22ssp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvProfileMeshStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:text="⚡ Online • 🛡️ 90%"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Profile Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/_1sdp"
                app:strokeColor="@color/colorOutline"
                app:cardCornerRadius="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_20sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/_16sdp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profileImage"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_64sdp"
                            android:src="@drawable/ic_profile_placeholder"
                            app:civ_border_width="@dimen/_2sdp"
                            app:civ_border_color="@color/colorPrimary"
                            android:layout_marginEnd="@dimen/_16sdp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/profileName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/username"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/_18ssp"
                                android:fontFamily="sans-serif-medium"
                                android:ellipsize="end"
                                android:maxLines="1" />

                            <LinearLayout
                                android:id="@+id/layoutProfileUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:id="@+id/profileUsername"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/username"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/_13ssp"
                                    android:fontFamily="sans-serif-medium" />

                                <ImageView
                                    android:id="@+id/icProfileUsernameDropdown"
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:layout_marginStart="@dimen/_4sdp"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="@color/colorPrimary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/profileStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/online"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/_12ssp"
                                android:layout_marginTop="@dimen/_2sdp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/editProfileButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_38sdp"
                            android:text="Edit"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_12ssp"
                            app:cornerRadius="@dimen/_19sdp"
                            android:paddingStart="@dimen/_14sdp"
                            android:paddingEnd="@dimen/_14sdp" />
                    </LinearLayout>

                    <!-- Hairline Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorOutline"
                        android:layout_marginBottom="@dimen/_14sdp" />

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/contactsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/_16ssp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contacts"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/_11ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/groupsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/_16ssp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Groups"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/_11ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/channelsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/_16ssp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Channels"
                                android:textColor="@color/textSecondary"
                                android:textSize="@dimen/_11ssp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wallet Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorPrimaryContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_20sdp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="Veil Wallet"
                            android:textColor="@color/colorOnPrimaryContainer"
                            android:textSize="@dimen/_12ssp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/btnOpenWalletSheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_filter_chip"
                            android:paddingStart="@dimen/_10sdp"
                            android:paddingEnd="@dimen/_10sdp"
                            android:paddingTop="@dimen/_3sdp"
                            android:paddingBottom="@dimen/_3sdp"
                            android:text="💳 Wallet"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_11ssp"
                            android:fontFamily="sans-serif-medium" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/walletBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="0 VC"
                        android:textColor="@color/colorOnPrimaryContainer"
                        android:textSize="@dimen/_26ssp"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="@dimen/_16ssp"
                        app:autoSizeMaxTextSize="@dimen/_26ssp"
                        app:autoSizeStepGranularity="@dimen/_1ssp" />

                    <TextView
                        android:id="@+id/walletCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="LVL 1 • 🔥 0d Streak • ⭐ 0 Karma"
                        android:textColor="@color/colorOnPrimaryContainer"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="sans-serif"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_16sdp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sendMoneyButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/_6sdp"
                            android:text="Send"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_13ssp"
                            app:backgroundTint="@color/colorPrimary"
                            app:cornerRadius="@dimen/_12sdp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addFundsButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:text="Add Funds"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_13ssp"
                            android:fontFamily="sans-serif-medium"
                            app:backgroundTint="@color/colorSurface"
                            app:strokeColor="@color/colorOutline"
                            app:strokeWidth="@dimen/_1sdp"
                            app:cornerRadius="@dimen/_12sdp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stealth Mode Toggle Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/_1sdp"
                app:strokeColor="@color/colorOutline"
                app:cardCornerRadius="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_16sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/ic_shield_locked"
                        app:tint="@color/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stealth Mode"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hide online presence completely"
                            android:textColor="@color/textSecondary"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/stealthModeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Group Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/_1sdp"
                app:strokeColor="@color/colorOutline"
                app:cardCornerRadius="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Account Settings -->
                    <LinearLayout
                        android:id="@+id/accountSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Account &amp; Security"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- Privacy Settings -->
                    <LinearLayout
                        android:id="@+id/privacySettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Privacy &amp; Vanishing"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- Linked Devices & Web Companion -->
                    <LinearLayout
                        android:id="@+id/linkedDevicesSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_qr_code"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Linked Devices &amp; Web"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:id="@+id/tvLinkedDevicesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QR Scanner"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_13ssp"
                            android:layout_marginEnd="@dimen/_8sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- Notification Settings -->
                    <LinearLayout
                        android:id="@+id/notificationSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Notifications"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- Appearance Settings -->
                    <LinearLayout
                        android:id="@+id/appearanceSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_appearance"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Appearance"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- Storage Settings -->
                    <LinearLayout
                        android:id="@+id/storageSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Storage &amp; Data"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- Language Settings -->
                    <LinearLayout
                        android:id="@+id/languageSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_language"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Language"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:id="@+id/currentLanguage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English"
                            android:textColor="@color/textSecondary"
                            android:textSize="@dimen/_13ssp"
                            android:layout_marginEnd="@dimen/_8sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Support & About Group Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardElevation="0dp"
                app:strokeWidth="@dimen/_1sdp"
                app:strokeColor="@color/colorOutline"
                app:cardCornerRadius="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Help Center -->
                    <LinearLayout
                        android:id="@+id/helpSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_help"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="Help &amp; Security Center"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/_1sdp" android:background="@color/colorOutline" />

                    <!-- About VEIL -->
                    <LinearLayout
                        android:id="@+id/aboutSettings"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:src="@drawable/ic_veil_shield"
                            app:tint="@color/textSecondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:text="About VEIL"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/_15ssp" />

                        <TextView
                            android:id="@+id/appVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v1.0.0"
                            android:textColor="@color/textSecondary"
                            android:textSize="@dimen/_13ssp"
                            android:layout_marginEnd="@dimen/_8sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/textSecondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:text="Log Out of VEIL"
                android:textColor="@color/colorError"
                app:cornerRadius="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_24sdp" />

        </LinearLayout>
    </ScrollView>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_32sdp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Failed to load profile"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_18ssp"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="Retry"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="visible" />

</RelativeLayout>
