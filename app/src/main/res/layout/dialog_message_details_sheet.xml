<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_24sdp"
    android:paddingEnd="@dimen/_24sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Handle Bar -->
    <View
        android:id="@+id/detailsHandleBar"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp" />

    <TextView
        android:id="@+id/tvDetailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Message Info"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_20ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:id="@+id/tvDetailsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End-to-End Encrypted"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp"
        android:layout_marginBottom="@dimen/_18sdp" />

    <!-- Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detailsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/colorOutline"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        android:layout_marginBottom="@dimen/_16sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <!-- Sent Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/_12sdp">

                <TextView
                    android:id="@+id/tvSentLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sent"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/tvDetailsSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Delivered Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/_12sdp">

                <TextView
                    android:id="@+id/tvDeliveredLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delivered"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/tvDetailsDelivered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Read Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/_12sdp">

                <TextView
                    android:id="@+id/tvReadLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Read"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:id="@+id/tvDetailsRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#22C55E"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/detailsDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/dividerColor"
                android:layout_marginBottom="@dimen/_12sdp" />

            <!-- Message ID / Hash Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMessageIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message ID"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_12ssp"
                    android:layout_marginBottom="@dimen/_4sdp" />

                <TextView
                    android:id="@+id/tvDetailsMessageId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDetails"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:text="Close"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>
