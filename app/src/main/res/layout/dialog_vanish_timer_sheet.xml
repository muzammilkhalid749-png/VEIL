<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_20sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Disappearing Messages Timer"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_17ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_3sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set how long messages stay before disappearing:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp"
        android:layout_marginBottom="@dimen/_13sdp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_300sdp">

        <LinearLayout
            android:id="@+id/vanishOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
