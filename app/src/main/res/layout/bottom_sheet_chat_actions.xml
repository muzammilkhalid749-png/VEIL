<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/text_secondary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvSheetChatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conversation Options"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetChatSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Manage notifications, pin, archive, or delete chat"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutline"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/actionMarkReadUnread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✓✓  Mark as unread"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📌  Pin to top"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionMute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔕  Mute notifications"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionVanishTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️  Disappearing messages (Vanish timer)"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionLockChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒  Lock chat with PIN"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionSecretVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🕵️  Move to Secret Vault folder"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionArchive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📥  Archive chat"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutline"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/actionClearChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧹  Clear chat messages"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️  Delete conversation"
        android:textColor="@color/error_red"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
