<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Modern Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Chat Title & Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvSheetChatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conversation Options"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSheetChatSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Manage notifications, pin, archive, or delete chat"
            android:textColor="@color/textSecondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutline"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/actionMarkReadUnread"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Mark as unread"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_check_double"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Pin to top"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_chat_pin"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionMute"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Mute notifications"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_chat_mute"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionVanishTimer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Disappearing messages (Vanish timer)"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_timer"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionLockChat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Lock chat with PIN"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_lock"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionSecretVault"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Move to Secret Vault folder"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_shield_locked"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionArchive"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Archive chat"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_archive"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutline"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/actionClearChat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Clear chat messages"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_delete"
        app:drawableTint="@color/textSecondary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/actionDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Delete conversation"
        android:textColor="@color/colorError"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_delete"
        app:drawableTint="@color/colorError"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
