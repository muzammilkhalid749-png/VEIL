<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_20sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_24sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp" />

    <TextView
        android:id="@+id/tvForwardSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forward Message"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_20ssp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tvForwardSheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a conversation or share to external apps"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_14sdp" />

    <!-- Share Externally Option -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShareExternal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/colorOutline"
        app:cardBackgroundColor="@color/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/_14sdp">

            <FrameLayout
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/bg_attach_item"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/_12sdp">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share to other apps…"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_15ssp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System share sheet (Signal, Telegram, etc.)"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/colorOutline"
        android:layout_marginBottom="@dimen/_10sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONVERSATIONS"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_12ssp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_8sdp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_320sdp">

        <LinearLayout
            android:id="@+id/forwardChatsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/forwardEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No other active conversations found"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp"
        android:gravity="center"
        android:paddingTop="@dimen/_20sdp"
        android:paddingBottom="@dimen/_20sdp"
        android:visibility="gone" />

</LinearLayout>
