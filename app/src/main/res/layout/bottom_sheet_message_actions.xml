<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_24sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_14sdp" />

    <!-- Emoji Reactions Strip -->
    <LinearLayout
        android:id="@+id/reactionsStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp">

        <TextView
            android:id="@+id/reactionThumbsUp"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:gravity="center"
            android:text="👍"
            android:textSize="@dimen/_24ssp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/reactionHeart"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="@dimen/_24ssp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/reactionLaugh"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:gravity="center"
            android:text="😂"
            android:textSize="@dimen/_24ssp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/reactionWow"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:gravity="center"
            android:text="😮"
            android:textSize="@dimen/_24ssp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/reactionSad"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:gravity="center"
            android:text="😢"
            android:textSize="@dimen/_24ssp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/reactionPray"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:gravity="center"
            android:text="🙏"
            android:textSize="@dimen/_24ssp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/colorOutline" />

    <!-- Action: Reply -->
    <LinearLayout
        android:id="@+id/actionReply"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_reply"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Reply"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Comments / Discussion -->
    <LinearLayout
        android:id="@+id/actionComments"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_chat"
            app:tint="@color/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Comments &amp; Discussion"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Action: Copy -->
    <LinearLayout
        android:id="@+id/actionCopy"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_copy"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Copy"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Forward -->
    <LinearLayout
        android:id="@+id/actionForward"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_forward"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Forward"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Info -->
    <LinearLayout
        android:id="@+id/actionInfo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_info"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Message info &amp; details"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Edit (within 15m time window) -->
    <LinearLayout
        android:id="@+id/actionEdit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_edit"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Edit message"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

        <TextView
            android:id="@+id/tvEditRemainingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Action: Select Multiple Messages -->
    <LinearLayout
        android:id="@+id/actionSelectMessages"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_check"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Select messages"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Pin to Top -->
    <LinearLayout
        android:id="@+id/actionPin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_chat_pin"
            app:tint="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Pin / Unpin message"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Favorite Media (Sticker / GIF / Emoji) -->
    <LinearLayout
        android:id="@+id/actionFavoriteMedia"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivFavoriteMediaIcon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_star"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/tvFavoriteMediaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Add to Favorites"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Bookmark Message -->
    <LinearLayout
        android:id="@+id/actionBookmark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivBookmarkIcon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_star_outline"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/tvBookmarkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Bookmark message"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <!-- Action: Translate Message -->
    <LinearLayout
        android:id="@+id/actionTranslate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivTranslateIcon"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_language"
            app:tint="@color/textPrimary" />

        <TextView
            android:id="@+id/tvTranslateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Translate message"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/colorOutline" />

    <!-- Action: Delete -->
    <LinearLayout
        android:id="@+id/actionDelete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_delete"
            app:tint="@color/colorError" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:text="Delete message"
            android:textColor="@color/colorError"
            android:textSize="@dimen/_15ssp" />

    </LinearLayout>

</LinearLayout>
