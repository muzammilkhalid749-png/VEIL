<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/homeCoordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/homeAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <LinearLayout
                android:id="@+id/homeHeaderSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways">

            <!-- Contextual Chat Multi-Selection Action Bar -->
            <LinearLayout
                android:id="@+id/chatMultiSelectBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:background="@drawable/bg_chat_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnChatSelectClose"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/textPrimary"
                    android:contentDescription="Cancel selection" />

                <TextView
                    android:id="@+id/tvChatSelectCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="1 selected"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnChatSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_28sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="@dimen/_7sdp"
                    android:paddingEnd="@dimen/_7sdp"
                    android:text="All"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnChatSelectPin"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/textPrimary"
                    android:contentDescription="Pin or Unpin selected" />

                <ImageButton
                    android:id="@+id/btnChatSelectMute"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_notifications_off"
                    app:tint="@color/textPrimary"
                    android:contentDescription="Mute or Unmute selected" />

                <ImageButton
                    android:id="@+id/btnChatSelectArchive"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_archive"
                    app:tint="@color/textPrimary"
                    android:contentDescription="Archive selected" />

                <ImageButton
                    android:id="@+id/btnChatSelectDelete"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/statusError"
                    android:contentDescription="Delete selected" />

                <ImageButton
                    android:id="@+id/btnChatSelectMore"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/textPrimary"
                    android:contentDescription="More chat actions" />
            </LinearLayout>

            <!-- WhatsApp-Style Inline Search Bar -->
            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginStart="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:background="@drawable/bg_chat_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etSearchChats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@null"
                    android:hint="Search chats or messages..."
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary"
                    android:textSize="@dimen/_12ssp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:padding="@dimen/_3sdp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/textSecondary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- WhatsApp-Style Filter Chips Row -->
            <HorizontalScrollView
                android:id="@+id/filterChipsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="@dimen/_13sdp"
                android:paddingEnd="@dimen/_13sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="All"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="🟢 Status"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterUnread"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="Unread"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterGroups"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="Groups"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterRequests"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="📥 Requests"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterVanish"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="⏱️ Vanish"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterPinned"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="📌 Pinned"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/chipFilterSecret"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_27sdp"
                        android:gravity="center"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:background="@drawable/bg_filter_chip"
                        android:text="🔒 Secret Vault"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- WhatsApp Status (24h Updates) Horizontal Tray (_name_removed__res_0x7f0e0142.xml) -->
            <LinearLayout
                android:id="@+id/statusTraySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_13sdp"
                    android:paddingEnd="@dimen/_13sdp"
                    android:paddingBottom="@dimen/_3sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Status"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/_15ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/statusTilesScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingStart="@dimen/_13sdp"
                    android:paddingEnd="@dimen/_13sdp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/statusTilesContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:background="@color/colorOutline" />
            </LinearLayout>

            <!-- WhatsApp-Style Locked Chats / Secret Vault Folder Row -->
            <LinearLayout
                android:id="@+id/secretVaultRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_17sdp"
                android:paddingEnd="@dimen/_17sdp"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_13sdp"
                    android:text="Locked chats"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/secretVaultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:text="0" />

            </LinearLayout>

            <View
                android:id="@+id/secretVaultDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/colorOutline"
                android:visibility="gone" />

            <!-- Archived Header Row -->
            <LinearLayout
                android:id="@+id/archivedRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_17sdp"
                android:paddingEnd="@dimen/_17sdp"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_archive"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_13sdp"
                    android:text="Archived"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/archivedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    android:text="0" />

            </LinearLayout>

            <View
                android:id="@+id/archivedDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/colorOutline"
                android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Chats List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_80sdp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical" />

        <!-- WhatsApp Status Feed List (when Status filter is active) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/statusFeedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:visibility="gone"
            android:paddingBottom="@dimen/_80sdp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/statusFeedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <!-- Empty State -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="always"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/_27sdp"
                android:paddingBottom="@dimen/_83sdp">

                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/ic_chat_empty"
                    android:layout_marginBottom="@dimen/_17sdp"
                    app:tint="@color/textSecondary"
                    android:contentDescription="@string/no_conversations" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_conversations"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_17ssp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/_7sdp" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_new_conversation_hint"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_12ssp"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/_2sdp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startChatButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_40sdp"
                    android:text="@string/start_chat"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:paddingStart="@dimen/_23sdp"
                    android:paddingEnd="@dimen/_23sdp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="visible" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</RelativeLayout>
