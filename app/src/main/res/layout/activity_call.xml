<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen">

    <!-- 1. Fullscreen Remote Video View (WebRTC Video Mesh) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- 2. Translucent Scrim Overlay for Video Mode Readability -->
    <View
        android:id="@+id/videoScrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone" />

    <!-- 3. Floating Picture-in-Picture Local Video View (Corner Window) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLocalVideo"
        android:layout_width="@dimen/_104sdp"
        android:layout_height="@dimen/_154sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/_56sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        app:cardCornerRadius="@dimen/_18sdp"
        app:cardElevation="@dimen/_10sdp"
        app:cardBackgroundColor="@android:color/black"
        android:visibility="gone">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- 3.5. Top Bar Minimize Call Button (WhatsApp & Telegram Parity) -->
    <ImageView
        android:id="@+id/btnMinimizeCall"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_56sdp"
        android:background="@drawable/bg_call_dock_item"
        android:padding="@dimen/_10sdp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/colorTextPrimary"
        android:elevation="@dimen/_8sdp"
        android:contentDescription="Minimize Call" />

    <!-- 4. Top Info Container (Caller Name, Status Pill, E2EE Security Badge) -->
    <LinearLayout
        android:id="@+id/topCallInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/_56sdp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_24sdp"
        android:paddingEnd="@dimen/_24sdp">

        <!-- Security Pill -->
        <LinearLayout
            android:id="@+id/layoutSecurityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_6sdp">

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:src="@drawable/ic_lock"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvCallSecurityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P2P Encrypted Mesh"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Caller Display Name -->
        <TextView
            android:id="@+id/callContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Contact Name"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/_24ssp"
            android:textStyle="bold" />

        <!-- Status / Duration Pill -->
        <TextView
            android:id="@+id/callStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="Calling..."
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/_15ssp" />
    </LinearLayout>

    <!-- 5. Central Audio Call Stage (Avatar with Concentric Breathing Wave Rings) -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="@dimen/_260sdp"
        android:layout_height="@dimen/_260sdp"
        android:layout_centerInParent="true">

        <!-- Outer Pulsing Ripple Wave -->
        <View
            android:id="@+id/avatarPulseRingOuter"
            android:layout_width="@dimen/_250sdp"
            android:layout_height="@dimen/_250sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_pulse_ring_outer"
            android:alpha="0.7" />

        <!-- Middle Breathing Ripple Wave -->
        <View
            android:id="@+id/avatarPulseRingMiddle"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_pulse_ring_middle"
            android:alpha="0.85" />

        <!-- Inner Aura Wave -->
        <View
            android:id="@+id/avatarPulseRing"
            android:layout_width="@dimen/_164sdp"
            android:layout_height="@dimen/_164sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_pulse_ring_inner" />

        <!-- Radial Ambient Glow -->
        <View
            android:id="@+id/avatarGlow"
            android:layout_width="@dimen/_144sdp"
            android:layout_height="@dimen/_144sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_avatar_glow" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/callAvatar"
            android:layout_width="@dimen/_132sdp"
            android:layout_height="@dimen/_132sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_profile_placeholder"
            app:civ_border_color="@color/colorPrimary"
            app:civ_border_width="@dimen/_3sdp" />
    </FrameLayout>

    <!-- 6. Fullscreen Flying Reaction Particle Canvas -->
    <FrameLayout
        android:id="@+id/reactionsOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 7. Floating In-Call Quick Reaction Pill Strip (Pop-out Bar) -->
    <LinearLayout
        android:id="@+id/reactionsFloatingBar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_52sdp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/_72sdp"
        android:background="@drawable/bg_call_reaction_pill"
        android:elevation="@dimen/_14sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rxHeart"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="â¤ï¸"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:id="@+id/rxFire"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="ðŸ”¥"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:id="@+id/rxClap"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="ðŸ‘"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:id="@+id/rxLaugh"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="ðŸ˜‚"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:id="@+id/rxParty"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="ðŸŽ‰"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:id="@+id/rxThumbsUp"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="ðŸ‘"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:id="@+id/rxMindBlown"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:gravity="center"
            android:text="ðŸ¤¯"
            android:textSize="@dimen/_22ssp" />
    </LinearLayout>

    <!-- 8. Floating Vertical Side Dock (Right-Side Ergonomic Thumb Reach) -->
    <LinearLayout
        android:id="@+id/layoutSideDock"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/_16sdp"
        android:background="@drawable/bg_call_side_dock"
        android:elevation="@dimen/_8sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp">

        <!-- 1. Live Reactions Trigger -->
        <FrameLayout
            android:id="@+id/btnDockReaction"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 2. Flip / Switch Camera (Visible on Video Calls) -->
        <FrameLayout
            android:id="@+id/btnDockFlipCamera"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flip_camera"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 3. Screen Share Toggle -->
        <FrameLayout
            android:id="@+id/btnDockScreenShare"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDockScreenShare"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_devices"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 4. Video Masking / Face Blur (Visible on Video Calls) -->
        <FrameLayout
            android:id="@+id/btnDockVideoMask"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Video Masking / Face Blur"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivDockVideoMask"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video_mask"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 5. Voice FX / Voice Masking -->
        <FrameLayout
            android:id="@+id/btnDockVoiceMask"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Voice FX / Masking">

            <ImageView
                android:id="@+id/ivDockVoiceMask"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_voice_mask"
                app:tint="@color/colorTextPrimary" />

            <View
                android:id="@+id/dotDockVoiceMaskActive"
                android:layout_width="@dimen/_6sdp"
                android:layout_height="@dimen/_6sdp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_green_pulse_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 6. Raise / Lower Hand (Group Calls) -->
        <FrameLayout
            android:id="@+id/btnDockRaiseHand"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Raise Hand"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivDockRaiseHand"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_raise_hand"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 7. Call Options / More Menu -->
        <FrameLayout
            android:id="@+id/btnDockOptions"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

    </LinearLayout>

    <!-- 9. Hidden Legacy Effects Compatibility Containers (Guarantees zero null reference crashes) -->
    <HorizontalScrollView
        android:id="@+id/callEffectsRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/btnVideoMasking" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/btnVoiceMasking" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/btnScreenShare" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/btnCallMore" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/btnSwitchCamera" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 10. Minimal Modern Bottom Call Control Bar -->
    <LinearLayout
        android:id="@+id/callControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_36sdp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Primary Controls Row: Mic, Speaker, Video, End/Accept -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp">

            <!-- Mic Toggle Button -->
            <LinearLayout
                android:id="@+id/btnToggleMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/_18sdp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivToggleMic"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_54sdp"
                    android:background="@drawable/bg_call_control_btn"
                    android:padding="@dimen/_16sdp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvToggleMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Mute"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- Speaker Toggle Button -->
            <LinearLayout
                android:id="@+id/btnToggleSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/_18sdp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivToggleSpeaker"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_54sdp"
                    android:background="@drawable/bg_call_control_btn"
                    android:padding="@dimen/_16sdp"
                    android:src="@drawable/ic_call"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvToggleSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Speaker"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- Video Toggle Button -->
            <LinearLayout
                android:id="@+id/btnToggleVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="@dimen/_18sdp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivToggleVideo"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_54sdp"
                    android:background="@drawable/bg_call_control_btn"
                    android:padding="@dimen/_16sdp"
                    android:src="@drawable/ic_video"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvToggleVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Video"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- End / Decline Call Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnEndCall"
                    android:layout_width="@dimen/_62sdp"
                    android:layout_height="@dimen/_62sdp"
                    android:background="@drawable/bg_call_dock_item"
                    android:backgroundTint="@color/colorError"
                    android:padding="@dimen/_16sdp"
                    android:src="@drawable/ic_call"
                    android:rotation="135"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvEndCallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="End"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- Incoming Accept Button -->
            <LinearLayout
                android:id="@+id/layoutAcceptCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_24sdp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnAcceptCall"
                    android:layout_width="@dimen/_62sdp"
                    android:layout_height="@dimen/_62sdp"
                    android:background="@drawable/bg_call_dock_item"
                    android:backgroundTint="@color/colorSuccess"
                    android:padding="@dimen/_16sdp"
                    android:src="@drawable/ic_call"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Accept"
                    android:textColor="@color/colorSuccess"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
