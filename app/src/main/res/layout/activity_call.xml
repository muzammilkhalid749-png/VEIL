<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen">

    <!-- 1. Fullscreen Remote Video View (WebRTC Video Mesh) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- 2. Translucent Scrim Overlay for Video Mode Readability -->
    <View
        android:id="@+id/videoScrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone" />

    <!-- 3. Floating Picture-in-Picture Local Video View (Corner Window) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLocalVideo"
        android:layout_width="104dp"
        android:layout_height="154dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@android:color/black"
        android:visibility="gone">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- 3.5. Top Bar Minimize Call Button (WhatsApp & Telegram Parity) -->
    <ImageView
        android:id="@+id/btnMinimizeCall"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_call_dock_item"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/colorTextPrimary"
        android:elevation="8dp"
        android:contentDescription="Minimize Call" />

    <!-- 4. Top Info Container (Caller Name, Status Pill, E2EE Security Badge) -->
    <LinearLayout
        android:id="@+id/topCallInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Security Pill -->
        <LinearLayout
            android:id="@+id/layoutSecurityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvCallSecurityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P2P Encrypted Mesh"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Caller Display Name -->
        <TextView
            android:id="@+id/callContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Contact Name"
            android:textColor="@color/colorTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Status / Duration Pill -->
        <TextView
            android:id="@+id/callStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Calling..."
            android:textColor="@color/colorTextSecondary"
            android:textSize="14.5sp" />
    </LinearLayout>

    <!-- 5. Central Audio Call Stage (Avatar with Concentric Breathing Wave Rings) -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true">

        <!-- Outer Pulsing Ripple Wave -->
        <View
            android:id="@+id/avatarPulseRingOuter"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_pulse_ring_outer"
            android:alpha="0.7" />

        <!-- Middle Breathing Ripple Wave -->
        <View
            android:id="@+id/avatarPulseRingMiddle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_pulse_ring_middle"
            android:alpha="0.85" />

        <!-- Inner Aura Wave -->
        <View
            android:id="@+id/avatarPulseRing"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_pulse_ring_inner" />

        <!-- Radial Ambient Glow -->
        <View
            android:id="@+id/avatarGlow"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_avatar_glow" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/callAvatar"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_profile_placeholder"
            app:civ_border_color="@color/colorPrimary"
            app:civ_border_width="3dp" />
    </FrameLayout>

    <!-- 6. Fullscreen Flying Reaction Particle Canvas -->
    <FrameLayout
        android:id="@+id/reactionsOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 7. Floating In-Call Quick Reaction Pill Strip (Pop-out Bar) -->
    <LinearLayout
        android:id="@+id/reactionsFloatingBar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="72dp"
        android:background="@drawable/bg_call_reaction_pill"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rxHeart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="â¤ï¸"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rxFire"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="ðŸ”¥"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rxClap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="ðŸ‘"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rxLaugh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="ðŸ˜‚"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rxParty"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="ðŸŽ‰"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rxThumbsUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="ðŸ‘"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rxMindBlown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="ðŸ¤¯"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 8. Floating Vertical Side Dock (Right-Side Ergonomic Thumb Reach) -->
    <LinearLayout
        android:id="@+id/layoutSideDock"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_call_side_dock"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 1. Live Reactions Trigger -->
        <FrameLayout
            android:id="@+id/btnDockReaction"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 2. Flip / Switch Camera (Visible on Video Calls) -->
        <FrameLayout
            android:id="@+id/btnDockFlipCamera"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flip_camera"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 3. Screen Share Toggle -->
        <FrameLayout
            android:id="@+id/btnDockScreenShare"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDockScreenShare"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_devices"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 4. Video Masking / Face Blur (Visible on Video Calls) -->
        <FrameLayout
            android:id="@+id/btnDockVideoMask"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Video Masking / Face Blur"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivDockVideoMask"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video_mask"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 5. Voice FX / Voice Masking -->
        <FrameLayout
            android:id="@+id/btnDockVoiceMask"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Voice FX / Masking">

            <ImageView
                android:id="@+id/ivDockVoiceMask"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_voice_mask"
                app:tint="@color/colorTextPrimary" />

            <View
                android:id="@+id/dotDockVoiceMaskActive"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_green_pulse_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 6. Raise / Lower Hand (Group Calls) -->
        <FrameLayout
            android:id="@+id/btnDockRaiseHand"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Raise Hand"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivDockRaiseHand"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_raise_hand"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- 7. Call Options / More Menu -->
        <FrameLayout
            android:id="@+id/btnDockOptions"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_call_dock_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

    </LinearLayout>

    <!-- 9. Hidden Legacy Effects Compatibility Containers (Guarantees zero null reference crashes) -->
    <HorizontalScrollView
        android:id="@+id/callEffectsRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/btnVideoMasking" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/btnVoiceMasking" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/btnScreenShare" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/btnCallMore" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/btnSwitchCamera" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 10. Minimal Modern Bottom Call Control Bar -->
    <LinearLayout
        android:id="@+id/callControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Primary Controls Row: Mic, Speaker, Video, End/Accept -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Mic Toggle Button -->
            <LinearLayout
                android:id="@+id/btnToggleMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="18dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivToggleMic"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_call_control_btn"
                    android:padding="16dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvToggleMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mute"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Speaker Toggle Button -->
            <LinearLayout
                android:id="@+id/btnToggleSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="18dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivToggleSpeaker"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_call_control_btn"
                    android:padding="16dp"
                    android:src="@drawable/ic_call"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvToggleSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Speaker"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Video Toggle Button -->
            <LinearLayout
                android:id="@+id/btnToggleVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginEnd="18dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivToggleVideo"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_call_control_btn"
                    android:padding="16dp"
                    android:src="@drawable/ic_video"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvToggleVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Video"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- End / Decline Call Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnEndCall"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_dock_item"
                    android:backgroundTint="@color/colorError"
                    android:padding="16dp"
                    android:src="@drawable/ic_call"
                    android:rotation="135"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvEndCallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="End"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Incoming Accept Button -->
            <LinearLayout
                android:id="@+id/layoutAcceptCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginStart="24dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnAcceptCall"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_call_dock_item"
                    android:backgroundTint="@color/colorSuccess"
                    android:padding="16dp"
                    android:src="@drawable/ic_call"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Accept"
                    android:textColor="@color/colorSuccess"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
