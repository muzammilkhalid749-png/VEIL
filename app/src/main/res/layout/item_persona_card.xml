<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personaCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/_16sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_14sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_12sdp">

        <!-- Persona Monogram / Icon Badge -->
        <FrameLayout
            android:id="@+id/flPersonaAvatar"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_12sdp">

            <View
                android:id="@+id/vPersonaAvatarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_persona_avatar_circle" />

            <TextView
                android:id="@+id/tvPersonaAvatarGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_18ssp"
                android:fontFamily="sans-serif-medium" />
        </FrameLayout>

        <!-- Identity Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPersonaDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_15ssp" />

                <TextView
                    android:id="@+id/tvPersonaHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_13ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPersonaSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/textTertiary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <!-- Status / Action Pill -->
        <FrameLayout
            android:id="@+id/flStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp">

            <!-- Active Check Badge -->
            <LinearLayout
                android:id="@+id/llActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/bg_persona_active_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Active"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_11ssp" />
            </LinearLayout>

            <!-- Locked Pro Badge -->
            <LinearLayout
                android:id="@+id/llLockedBadge"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/bg_persona_locked_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/textSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="PRO"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_11ssp" />
            </LinearLayout>

            <!-- Inactive Subtle Radio Circle -->
            <View
                android:id="@+id/vInactiveIndicator"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:background="@drawable/bg_persona_inactive_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Delete Action (Only for non-primary personas) -->
        <ImageButton
            android:id="@+id/btnDeletePersona"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Persona"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_delete"
            app:tint="@color/colorError"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
