<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/archived_chats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- App Bar -->
        <LinearLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorSurface"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_16sdp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/textPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Archived Chats"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_18ssp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/_8sdp" />

        </LinearLayout>

        <!-- Contextual Archived/Vault Multi-Selection Action Bar -->
        <LinearLayout
            android:id="@+id/archivedMultiSelectBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorSurfaceVariant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnArchivedSelectClose"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_close"
                app:tint="@color/textPrimary"
                android:contentDescription="Cancel selection" />

            <TextView
                android:id="@+id/tvArchivedSelectCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_8sdp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="1 selected"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_17ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnArchivedSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_36sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="All"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnArchivedSelectMute"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_notifications_off"
                app:tint="@color/textPrimary"
                android:contentDescription="Mute or Unmute selected" />

            <ImageButton
                android:id="@+id/btnArchivedSelectUnarchive"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_archive"
                app:tint="@color/colorPrimary"
                android:contentDescription="Unarchive selected" />

            <ImageButton
                android:id="@+id/btnArchivedSelectDelete"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_delete"
                app:tint="@color/statusError"
                android:contentDescription="Delete selected" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/colorOutline" />

        <!-- Info Notice -->
        <LinearLayout
            android:id="@+id/archivedNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/_16sdp"
            android:background="@color/colorSurfaceVariant">

            <ImageView
                android:id="@+id/ivNoticeIcon"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_archive"
                app:tint="@color/textSecondary" />

            <TextView
                android:id="@+id/tvNoticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_12sdp"
                android:text="Chats are archived and will remain archived until you manually unarchive them."
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_13ssp"
                android:lineSpacingExtra="@dimen/_2sdp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/colorOutline" />

        <!-- Content Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Archived RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/archivedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_24sdp"
                android:clipToPadding="false" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="@dimen/_32sdp">

                <ImageView
                    android:id="@+id/ivEmptyIcon"
                    android:layout_width="@dimen/_64sdp"
                    android:layout_height="@dimen/_64sdp"
                    android:src="@drawable/ic_archive"
                    app:tint="@color/textSecondary"
                    android:layout_marginBottom="@dimen/_16sdp" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No archived chats"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_18ssp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/_6sdp" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chats you archive will appear here"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_14ssp"
                    android:gravity="center" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
