<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Top Navigation Bar -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/textPrimary" />

    <!-- Main Scrollable Container (guarantees zero clipping on compact screens) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:maxWidth="440dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <!-- Hero Shield Header -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/setup_secure_pin"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shield_locked" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="@string/setup_secure_pin"
                android:textColor="@color/textPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/pin_hint"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

            <!-- PIN Progress Dots Container -->
            <LinearLayout
                android:id="@+id/pinDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Error Feedback -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Responsive Number Pad (Fluid weights with max width for any screen) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="340dp"
                android:orientation="vertical">

                <!-- Row 1: 1, 2, 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button1"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="1"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/button2"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="2"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/button3"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="3"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- Row 2: 4, 5, 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button4"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="4"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/button5"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="5"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/button6"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="6"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- Row 3: 7, 8, 9 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button7"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="7"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/button8"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="8"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/button9"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="9"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- Row 4: Delete, 0, Clear -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonDelete"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif"
                        android:text="⌫"
                        android:textColor="@color/textSecondary"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/button0"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/buttonClear"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_number_pad"
                        android:fontFamily="sans-serif-medium"
                        android:text="C"
                        android:textColor="@color/textSecondary"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Action Buttons: Skip & Confirm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:maxWidth="340dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.01"
                    android:text="@string/skip_for_now"
                    android:textAllCaps="false"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmButton"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:letterSpacing="0.01"
                    android:text="@string/confirm_pin"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Security Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_shield"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/pin_secure_storage"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                app:drawableTint="@color/textSecondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
