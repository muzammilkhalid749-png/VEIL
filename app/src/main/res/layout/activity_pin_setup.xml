<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pin_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back"
        android:layout_marginTop="56dp"
        android:layout_marginStart="8dp"
        app:tint="@color/text_primary" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="60dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_shield_locked"
                android:scaleType="fitCenter"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_secure_pin"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pin_hint"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginTop="8dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- PIN Entry Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- PIN Progress Dots -->
            <LinearLayout
                android:id="@+id/pinDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp" />

            <!-- PIN Input (Hidden) -->
            <EditText
                android:id="@+id/pinEditText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:visibility="gone" />

            <!-- Error Message -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/error_red"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Number Pad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/button1"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button2"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="2"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button3"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="3"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad" />

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/button4"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="4"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button5"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="5"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button6"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="6"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad" />

            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/button7"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="7"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button8"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="8"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button9"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="9"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad" />

            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/buttonDelete"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="⌫"
                    android:textColor="@color/textSecondary"
                    android:textSize="20sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/button0"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="0"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:background="@drawable/button_number_pad"
                    android:layout_marginEnd="16dp" />

                <Button
                    android:id="@+id/buttonClear"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:text="C"
                    android:textColor="@color/textSecondary"
                    android:textSize="20sp"
                    android:background="@drawable/button_number_pad" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/skipButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/skip_for_now"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:background="@drawable/button_outline"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/confirmButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/confirm_pin"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:background="@drawable/button_primary"
                android:layout_marginStart="8dp"
                android:enabled="false" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Security Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_secure_storage"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:gravity="center" />

    </LinearLayout>

</RelativeLayout>