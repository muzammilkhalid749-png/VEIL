<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorSurface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/_8sdp">

                <!-- App Logo and Name -->
                <LinearLayout
                    android:id="@+id/layoutBrandHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/appLogo"
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_32sdp"
                        android:src="@drawable/veil_logo_small"
                        android:layout_marginEnd="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_20ssp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02" />

                </LinearLayout>

                <!-- App-Bar Micro-Pill (Ongoing / Ringing VoIP Call matching WhatsApp/Chatter) -->
                <LinearLayout
                    android:id="@+id/appBarCallMicroPill"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_toEndOf="@id/layoutBrandHeader"
                    android:layout_toStartOf="@id/layoutActionIcons"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_appbar_call_micropill"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone">

                    <View
                        android:id="@+id/pillPulseDot"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:background="@drawable/bg_green_pulse_dot"
                        android:layout_marginEnd="@dimen/_6sdp" />

                    <TextView
                        android:id="@+id/tvCallPillText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ongoing (00:00)"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_13ssp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Action Icons -->
                <LinearLayout
                    android:id="@+id/layoutActionIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true">

                    <!-- Search Icon -->
                    <ImageView
                        android:id="@+id/searchButton"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/textPrimary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_4sdp" />

                    <!-- Primary Action (New Chat/Post/Call) -->
                    <ImageView
                        android:id="@+id/newChatButton"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/textPrimary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_8sdp"
                        android:layout_marginEnd="@dimen/_4sdp" />

                    <!-- More / Overflow Menu -->
                    <ImageView
                        android:id="@+id/moreButton"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/textPrimary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_8sdp" />

                </LinearLayout>

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Subtle Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/colorOutline" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ViewPager for Fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/colorSurface">

        <!-- Subtle Hairline Top Border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/colorOutline" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            style="@style/Widget.Design.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:background="@color/colorSurface"
            app:menu="@menu/bottom_navigation_menu"
            app:itemIconTint="@drawable/bottom_nav_icon_colors"
            app:itemTextColor="@drawable/bottom_nav_text_colors"
            app:labelVisibilityMode="labeled"
            app:elevation="0dp"
            app:itemIconSize="@dimen/_22sdp"
            app:itemPaddingTop="@dimen/_4sdp"
            app:itemPaddingBottom="@dimen/_4sdp"
            app:itemActiveIndicatorStyle="@null"
            app:paddingBottomSystemWindowInsets="false"
            app:paddingLeftSystemWindowInsets="false"
            app:paddingRightSystemWindowInsets="false"
            app:paddingTopSystemWindowInsets="false" />
    </LinearLayout>

    <!-- Secondary Pencil / Text Status FAB (Shown when Status filter chip is active) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabStatusPencil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/_26sdp"
        android:layout_marginBottom="@dimen/_140sdp"
        android:src="@drawable/ic_edit"
        android:contentDescription="Text Status"
        android:visibility="gone"
        app:fabCustomSize="@dimen/_44sdp"
        app:maxImageSize="@dimen/_20sdp"
        app:backgroundTint="@color/colorSurfaceVariant"
        app:tint="@color/colorTextPrimary"
        app:elevation="@dimen/_4sdp"
        app:borderWidth="0dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_72sdp"
        android:src="@drawable/ic_edit"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@android:color/white"
        app:elevation="@dimen/_4sdp"
        app:borderWidth="0dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
