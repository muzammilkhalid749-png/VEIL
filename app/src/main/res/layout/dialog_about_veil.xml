<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_32sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <FrameLayout
        android:layout_width="@dimen/_72sdp"
        android:layout_height="@dimen/_72sdp"
        android:background="@drawable/bg_persona_avatar_circle"
        android:backgroundTint="@color/colorSurfaceVariant">

        <ImageView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_veil_shield" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:text="VEIL"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_22ssp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:text="Version 1.0.0 (Production Release)"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_13ssp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_3sdp"
        android:text="VEIL is a private and secure messenger built for confidential conversations. All chats, media, and calls are end-to-end encrypted directly on your device."
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_14ssp" />

    <!-- Feature Highlights Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/colorOutline"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Key Security Highlights"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:lineSpacingExtra="@dimen/_4sdp"
                android:text="• End-to-end encrypted messaging &amp; calls\n• Disappearing messages with auto-delete\n• Screen security &amp; screenshot protection\n• Passcode lock &amp; encrypted local storage\n• Multi-personas with separate profiles"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_13ssp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>