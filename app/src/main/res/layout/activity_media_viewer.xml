<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mediaViewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A">

    <!-- 1. STAGE 3: HORIZONTAL SWIPE PAGER (Full-Screen Photo/Video View Mode) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mediaViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- 2. STAGE 2: VERTICAL SCROLL ALBUM FEED (WhatsApp Multi-Photo/Video Album List) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mediaVerticalRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B141A"
        android:clipToPadding="false"
        android:paddingTop="88dp"
        android:paddingBottom="32dp"
        android:visibility="gone" />

    <!-- Single-Item Photo Container -->
    <com.m3.veil.ui.views.ZoomableImageView
        android:id="@+id/photoViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Single-Item Video Container -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <VideoView
            android:id="@+id/videoViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Center Frosted Glass Play/Pause Button -->
        <FrameLayout
            android:id="@+id/videoCenterPlayBtn"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_video_play_glass"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCenterPlayIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_play_arrow"
                app:tint="@android:color/white" />
        </FrameLayout>
    </FrameLayout>

    <!-- Top Overlay App Bar (WhatsApp Style: Back, You / Subtitle, Save, Forward, Status, 3-Dot Menu) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC0B141A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="36dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="You"
                    android:textColor="@android:color/white"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlbumCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_media_glass_chip"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="1 / 1"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Just now"
                android:textColor="#CCFFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnToggleScrollMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_media_glass_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="☷ Grid"
            android:textColor="@android:color/white"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Download / Save to Gallery Button -->
        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_download"
            app:tint="@android:color/white" />

        <!-- Forward Button -->
        <ImageView
            android:id="@+id/btnForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_forward"
            app:tint="@android:color/white" />

        <!-- Repost to Status Button -->
        <ImageView
            android:id="@+id/btnRepostStatus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_status_ring"
            app:tint="@android:color/white" />

        <!-- Hidden Share Button (still accessible via ID & 3-dot menu) -->
        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_share"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <!-- 3-Dot Overflow Menu Button (Edit, Share, Star, Show in chat, Create sticker, Delete, More) -->
        <ImageView
            android:id="@+id/btnMoreMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Bottom Stack: Video Seekbar + Caption + Thumbnail Strip + Unified Reply/Reaction Pill -->
    <LinearLayout
        android:id="@+id/bottomControlsWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Video Seekbar Row (Screenshot_20261029-172146.jpg: 00:01 [●━━━━] 00:20  1.0x) -->
        <LinearLayout
            android:id="@+id/videoControlsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnBottomPlayPause"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play_arrow"
                android:visibility="gone"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvVideoElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#80FFFFFF"
                android:progressTint="#00A884"
                android:thumbTint="#00A884" />

            <TextView
                android:id="@+id/tvVideoTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="00:20"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnVideoSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="1.0x"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Caption & Interactive Album Thumbnail Strip Bar -->
        <LinearLayout
            android:id="@+id/bottomCaptionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#80000000"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingBottom="6dp"
                android:textColor="@android:color/white"
                android:textSize="14.5sp" />

            <HorizontalScrollView
                android:id="@+id/albumThumbnailScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/albumThumbnailStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Unified WhatsApp Bottom Reply & Quick Emoji Reactions Pill (Screenshot 172134, 172146, Screenshot 5) -->
        <FrameLayout
            android:id="@+id/bottomReplyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0B141A"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="18dp"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/replyPillContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_media_glass_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/etMediaReply"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Reply"
                    android:imeOptions="actionSend"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textColorHint="#8696A0"
                    android:textSize="15.5sp" />

                <!-- Quick Emoji Reactions inside the pill on the right (❤️ 🙏 😊+) -->
                <TextView
                    android:id="@+id/reactionHeart"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="❤️"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/reactionPray"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="🙏"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/reactionLaugh"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="😊⁺"
                    android:textColor="@android:color/white"
                    android:textSize="19sp" />

                <ImageView
                    android:id="@+id/btnSendMediaReply"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_send"
                    android:visibility="gone"
                    app:tint="#00A884" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/viewerProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone" />

</FrameLayout>
