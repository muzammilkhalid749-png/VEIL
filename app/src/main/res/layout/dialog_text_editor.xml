<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#99000000">

    <TextView
        android:id="@+id/btnDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Done"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/_13sdp"
        android:paddingVertical="@dimen/_7sdp"
        android:background="@drawable/bg_done_button"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_27sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.m3.veil.ui.chat.ColorPickerView
        android:id="@+id/colorPickerView"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_208sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:elevation="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/addTextEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="Type something..."
        android:textColorHint="#99FFFFFF"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_27ssp"
        android:gravity="center"
        android:layout_marginHorizontal="@dimen/_53sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
