<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_24sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <!-- Minimal Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_4sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Personas"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/_19ssp" />

        <TextView
            android:id="@+id/tvPersonaSlotCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/textTertiary"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:text="Switch active identity for chats, calls, and discover."
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_360sdp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/personaListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddNewPersona"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:fontFamily="sans-serif-medium"
        android:text="New Persona"
        android:textSize="@dimen/_14ssp"
        app:cornerRadius="@dimen/_14sdp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/_8sdp"
        app:iconSize="@dimen/_18sdp" />

</LinearLayout>
