<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/username_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Top Navigation Bar -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="@dimen/_33sdp"
        android:layout_height="@dimen/_33sdp"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="@dimen/_7sdp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/textPrimary" />

    <!-- Main Scrollable Container (Keyboard and screen-size adaptive) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/_367sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingTop="@dimen/_47sdp"
            android:paddingBottom="@dimen/_20sdp">

            <!-- Profile / Avatar Icon -->
            <ImageView
                android:layout_width="@dimen/_53sdp"
                android:layout_height="@dimen/_53sdp"
                android:layout_marginBottom="@dimen/_13sdp"
                android:contentDescription="@string/complete_profile"
                android:scaleType="fitCenter"
                android:src="@drawable/veil_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="@string/complete_profile"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_23sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/choose_username_hint"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_12ssp" />

            <!-- Username Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/usernameInputLayout"
                style="@style/VeilInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:hint="@string/username">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/usernameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Availability Status Text -->
            <TextView
                android:id="@+id/usernameAvailabilityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_13sdp"
                android:fontFamily="sans-serif"
                android:paddingStart="@dimen/_3sdp"
                android:text="@string/enter_desired_username"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_10ssp" />

            <!-- Display Name (Optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/displayNameInputLayout"
                style="@style/VeilInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_17sdp"
                android:hint="@string/display_name_optional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/displayNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Guidelines Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:padding="@dimen/_13sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/username_guidelines"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/_3sdp"
                    android:text="@string/username_rules"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />

            </LinearLayout>

            <!-- Continue Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_43sdp"
                android:enabled="false"
                android:letterSpacing="0.01"
                android:text="@string/continue_to_veil"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/_12sdp" />

            <!-- Progress Spinner -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:layout_marginTop="@dimen/_13sdp"
                android:visibility="gone" />

            <!-- Random Profile Generator Link -->
            <TextView
                android:id="@+id/skipForNowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="@dimen/_7sdp"
                android:text="@string/generate_random_profile"
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
