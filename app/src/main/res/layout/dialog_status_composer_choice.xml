<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/statusSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/_8sdp">

        <!-- Modern Drag Handle -->
        <View
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_7sdp"
            android:background="@drawable/bg_persona_drag_handle" />

        <!-- Top Header Row: Close (X) on Left + Centered Title ("Add status" / "Start layout") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp">

            <FrameLayout
                android:id="@+id/btnCloseStatusChoice"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/colorTextPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvStatusSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Add status"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/_17ssp"
                android:textStyle="bold" />

            <!-- Symmetry Spacer -->
            <View
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp" />
        </LinearLayout>

        <!-- Layout Mode Subtitle ("Choose up to 6 photos for your layout.") -->
        <TextView
            android:id="@+id/tvLayoutModeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:gravity="center"
            android:text="Choose up to 6 photos for your layout."
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

        <!-- 4 Quick Creation Mode Pills Row (Text, Music, Layout, Voice) -->
        <LinearLayout
            android:id="@+id/layoutQuickStatusModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp">

            <!-- 1. Text -->
            <LinearLayout
                android:id="@+id/btnQuickText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_status_quick_btn">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/colorTextPrimary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <!-- 2. Music / Audio Vibe -->
            <LinearLayout
                android:id="@+id/btnQuickMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_status_quick_btn">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_music_note"
                        app:tint="@color/colorTextPrimary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Music"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <!-- 3. Layout (Collage up to 6 photos) -->
            <LinearLayout
                android:id="@+id/btnQuickLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_status_quick_btn">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_status_layout"
                        app:tint="@color/colorTextPrimary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Layout"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <!-- 4. Voice -->
            <LinearLayout
                android:id="@+id/btnQuickVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/_57sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_status_quick_btn">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/colorTextPrimary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Voice"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Album Selector Row ("Recents ▼") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_13sdp"
            android:paddingEnd="@dimen/_13sdp">

            <LinearLayout
                android:id="@+id/layoutStatusAlbumSelector"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_3sdp"
                android:paddingEnd="@dimen/_8sdp">

                <TextView
                    android:id="@+id/tvStatusCurrentAlbum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Recents"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivStatusAlbumChevron"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/colorTextPrimary" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatusSelectionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_10ssp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Gallery Grid & Floating Album Dropdown Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 3-Column Gallery Grid (Item 0 = Camera Tile, 1..N = Photos/Videos/GIFs) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStatusGalleryGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/_2sdp"
                android:paddingBottom="@dimen/_67sdp" />

            <ProgressBar
                android:id="@+id/statusGalleryProgressBar"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/veil_accent"
                android:visibility="gone" />

            <!-- Permission / Empty Fallback Card -->
            <LinearLayout
                android:id="@+id/layoutStatusGalleryPermission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_27sdp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="@dimen/_53sdp"
                    android:layout_height="@dimen/_53sdp"
                    android:background="@drawable/bg_persona_avatar_circle"
                    android:backgroundTint="@color/colorSurfaceVariant">

                    <ImageView
                        android:layout_width="@dimen/_23sdp"
                        android:layout_height="@dimen/_23sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/veil_accent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStatusPermTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Allow Access to Photos &amp; Videos"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusPermSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="Select photos and videos from your albums or capture a new moment with the camera."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_11ssp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStatusBrowseSystemFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_37sdp"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:text="Browse Photos &amp; Files"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/veil_accent"
                    app:cornerRadius="@dimen/_18sdp" />
            </LinearLayout>

            <!-- Scrim when Album Dropdown is open -->
            <View
                android:id="@+id/viewAlbumDropdownScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#26000000"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- Floating Album Dropdown Menu Card (Screenshots 4.jpg & 5.jpg) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusAlbumDropdown"
                android:layout_width="@dimen/_223sdp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/_17sdp"
                app:cardElevation="@dimen/_10sdp"
                app:strokeColor="@color/colorOutline"
                app:strokeWidth="@dimen/_1sdp">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="@dimen/_300sdp"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/llAlbumDropdownContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/_7sdp"
                        android:paddingBottom="@dimen/_7sdp" />
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- Floating Bottom-Right Folder / Multi-Select Button (Screenshots 2.jpg, 3.jpg, 4.jpg, 5.jpg) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fabStatusMultiOrFolder"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/_15sdp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/_13sdp"
                app:cardElevation="@dimen/_7sdp"
                app:strokeColor="@color/colorOutline"
                app:strokeWidth="@dimen/_1sdp">

                <ImageView
                    android:id="@+id/ivStatusMultiOrFolderIcon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_folder_multi"
                    app:tint="@color/colorTextPrimary" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Bottom Selected Photos Strip & Confirm Checkmark FAB (Screenshot 6.jpg) -->
        <LinearLayout
            android:id="@+id/layoutStatusBottomSelectionBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_63sdp"
            android:background="@color/colorSurface"
            android:elevation="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_13sdp"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/hsvStatusSelectedThumbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llStatusSelectedThumbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <FrameLayout
                android:id="@+id/fabStatusConfirmSelection"
                android:layout_width="@dimen/_43sdp"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    app:tint="@android:color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Hidden legacy IDs kept for backward safety -->
        <View
            android:id="@+id/btnQuickCamera"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btnQuickGallery"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/cardPhotoStatusOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/cardCameraStatusOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/cardTextStatusOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/cardVoiceStatusOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
