<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:padding="@dimen/_40sdp">

    <!-- Main Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Logo Container -->

        <RelativeLayout
            android:layout_width="@dimen/_250sdp"
            android:layout_height="@dimen/_250sdp"
            android:layout_marginBottom="@dimen/_28sdp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Frameless Ambient Radiant Halo (Behind Emblem) -->
            <ImageView
                android:id="@+id/shield_glow"
                android:layout_width="@dimen/_250sdp"
                android:layout_height="@dimen/_250sdp"
                android:layout_centerInParent="true"
                android:src="@drawable/shield_glow"
                android:scaleType="fitCenter" />

            <!-- Frameless Cloaked Whisper Animated Emblem -->
            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_200sdp"
                android:layout_centerInParent="true"
                android:scaleType="fitCenter" />

        </RelativeLayout>

        <!-- Text Container -->
        <LinearLayout
            android:id="@+id/text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_42ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_14ssp"
                android:layout_marginTop="@dimen/_8sdp"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif" />

            <!-- Minimal Modern Connection Status Pill -->
            <LinearLayout
                android:id="@+id/layout_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_22sdp"
                android:background="@drawable/bg_splash_connection_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_14sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:alpha="0">

                <!-- Micro Breathing Status Dot -->
                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="@dimen/_7sdp"
                    android:layout_height="@dimen/_7sdp"
                    android:layout_marginEnd="@dimen/_9sdp"
                    android:background="@drawable/bg_splash_status_dot" />

                <!-- Minimal Modern Status Label -->
                <TextView
                    android:id="@+id/tv_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="Connecting to secure mesh…"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Particles Background -->
    <ImageView
        android:id="@+id/particles_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/particles_background"
        android:scaleType="centerCrop"
        android:alpha="0.2" />

</RelativeLayout>