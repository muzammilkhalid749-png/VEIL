<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_18sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_18sdp"
    android:paddingBottom="@dimen/_22sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Voice &amp; Video"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_16ssp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:text="Private end-to-end encrypted calls"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp" />

    <!-- 1:1 Direct Call -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCallHubDirect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <FrameLayout
                android:layout_width="@dimen/_33sdp"
                android:layout_height="@dimen/_33sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:background="@drawable/bg_persona_avatar_circle">

                <ImageView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_call"
                    app:tint="@color/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Start Call"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Select a contact for 1:1 audio or HD video"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/textTertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Voice Roulette -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCallHubRoulette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <FrameLayout
                android:layout_width="@dimen/_33sdp"
                android:layout_height="@dimen/_33sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:background="@drawable/bg_persona_avatar_circle">

                <ImageView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calls"
                    app:tint="@color/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Voice Roulette"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Connect an anonymous audio call with a random peer"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/textTertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Clear Call Logs -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCallHubClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <FrameLayout
                android:layout_width="@dimen/_33sdp"
                android:layout_height="@dimen/_33sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:background="@drawable/bg_persona_avatar_circle">

                <ImageView
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_delete"
                    app:tint="#EF4444" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Clear Call History"
                    android:textColor="#EF4444"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Delete your local call history permanently"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/textTertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
