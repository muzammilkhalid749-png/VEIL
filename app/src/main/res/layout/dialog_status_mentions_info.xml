<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_24sdp"
    android:paddingEnd="@dimen/_24sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_24sdp"
    android:gravity="center_horizontal">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_marginBottom="@dimen/_20sdp" />

    <!-- Center Hero Badge: Modern Tinted Container -->
    <FrameLayout
        android:layout_width="@dimen/_64sdp"
        android:layout_height="@dimen/_64sdp"
        android:background="@drawable/bg_filter_chip"
        android:layout_marginBottom="@dimen/_16sdp">

        <ImageView
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mention"
            app:tint="@color/colorPrimary" />
    </FrameLayout>

    <!-- Main Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status Mentions"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_20ssp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_6sdp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="When you mention people or groups in your status"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_20sdp" />

    <!-- Modern Feature Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="@color/dividerColor"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        android:layout_marginBottom="@dimen/_24sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_12sdp">

            <!-- Feature 1: Private Notification -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_8sdp">

                <FrameLayout
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:background="@drawable/bg_filter_chip">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private Notification"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_14ssp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="Tagged peers receive a direct message notify"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/dividerColor" />

            <!-- Feature 2: Ephemeral Viewing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_8sdp">

                <FrameLayout
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:background="@drawable/bg_filter_chip">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_status_ring"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Direct Viewing"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_14ssp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="They can view your status directly from the notification"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/dividerColor" />

            <!-- Feature 3: Reshare Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_8sdp">

                <FrameLayout
                    android:layout_width="@dimen/_34sdp"
                    android:layout_height="@dimen/_34sdp"
                    android:background="@drawable/bg_filter_chip">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_share"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reshare Permission"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/_14ssp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:text="They can choose to reshare your update with their audience"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Primary Action: OK Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMentionsInfoOk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:text="OK, Got it"
        android:textColor="@color/colorOnPrimary"
        android:textSize="@dimen/_15ssp"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="@dimen/_14sdp"
        app:elevation="0dp" />

    <!-- Learn More Link -->
    <TextView
        android:id="@+id/btnMentionsLearnMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="Learn more"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="sans-serif-medium"
        android:padding="@dimen/_6sdp" />

</LinearLayout>
