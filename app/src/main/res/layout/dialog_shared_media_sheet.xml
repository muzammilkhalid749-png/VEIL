<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_17sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_20sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shared Media &amp; Vault Items"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_17ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_3sdp" />

    <TextView
        android:id="@+id/tvSharedMediaSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Media, documents, voice notes, and starred items in this chat"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_10ssp"
        android:layout_marginBottom="@dimen/_12sdp" />

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="@dimen/_12sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipMediaAll"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_27sdp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:text="All"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/_7sdp" />

            <TextView
                android:id="@+id/chipMediaImages"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_27sdp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:text="Images"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_11ssp"
                android:layout_marginEnd="@dimen/_7sdp" />

            <TextView
                android:id="@+id/chipMediaVoice"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_27sdp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:text="Voice"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_11ssp"
                android:layout_marginEnd="@dimen/_7sdp" />

            <TextView
                android:id="@+id/chipMediaPolls"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_27sdp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:text="Polls"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_11ssp"
                android:layout_marginEnd="@dimen/_7sdp" />

            <TextView
                android:id="@+id/chipMediaStarred"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_27sdp"
                android:background="@drawable/bg_filter_chip"
                android:gravity="center"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                android:text="Starred"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable Items Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_283sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/sharedMediaEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="@dimen/_27sdp"
                android:paddingBottom="@dimen/_27sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_33sdp"
                    android:layout_height="@dimen/_33sdp"
                    android:src="@drawable/ic_document"
                    app:tint="@color/textTertiary"
                    android:layout_marginBottom="@dimen/_7sdp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No items found"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/_3sdp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shared photos, voice notes, and starred messages\nwill appear in this vault."
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharedMediaItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
