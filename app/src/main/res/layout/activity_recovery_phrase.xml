<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recovery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_weight="1" />

        <!-- Shoulder-Surfing Privacy Toggle Pill -->
        <LinearLayout
            android:id="@+id/btnTogglePrivacyBlur"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/bg_paste_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp">

            <ImageView
                android:id="@+id/ivPrivacyEye"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:src="@drawable/ic_visibility_off"
                app:tint="@color/veil_accent" />

            <TextView
                android:id="@+id/tvPrivacyToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Hide Words"
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Scrollable Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/_460sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingTop="@dimen/_68sdp"
            android:paddingBottom="@dimen/_36sdp">

            <!-- Security Shield Icon Badge -->
            <FrameLayout
                android:layout_width="@dimen/_68sdp"
                android:layout_height="@dimen/_68sdp"
                android:layout_marginBottom="@dimen/_18sdp"
                android:background="@drawable/bg_restore_icon_circle">

                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Recovery Phrase"
                    android:src="@drawable/ic_shield_locked"
                    app:tint="@color/veil_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="12-Word Master Recovery Key"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/_22ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_18sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="These 12 secret words allow you to restore your sovereign account, personas, and chats. Keep them safe and private."
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_14ssp" />

            <!-- Deterministic Identity Proof Badge -->
            <TextView
                android:id="@+id/tvDerivedIdentityBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_16sdp"
                android:background="@drawable/bg_recovery_word_cell"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_9sdp"
                android:text="🔐 Derived UID: veil_... • CRC: ..."
                android:textColor="@color/veil_accent"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />

            <!-- 12-Word Numbered Grid Container Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_16sdp"
                android:background="@drawable/bg_phrase_card"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="BIP-39 SEED WORDS"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <!-- In-card toggle button -->
                    <LinearLayout
                        android:id="@+id/btnToggleWordsInCard"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_26sdp"
                        android:background="@drawable/bg_paste_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_9sdp">

                        <ImageView
                            android:id="@+id/ivInCardEye"
                            android:layout_width="@dimen/_14sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:src="@drawable/ic_visibility_off"
                            app:tint="@color/veil_accent" />

                        <TextView
                            android:id="@+id/tvInCardEyeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Hide"
                            android:textColor="@color/veil_accent"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wordsGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Raw Phrase Card (Selectable & Monospace) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_18sdp"
                android:background="@drawable/bg_phrase_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:letterSpacing="0.06"
                    android:text="RAW SECRET PHRASE"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/phraseText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/_6sdp"
                    android:textColor="@color/veil_accent"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Security Warning Banner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="Screenshots are blocked for security. Never share these words with anyone."
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_12ssp" />

            <!-- Action Buttons: Copy & Continue -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_52sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:letterSpacing="0.01"
                    android:text="Copy Words"
                    android:textAllCaps="false"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/_16sdp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmButton"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_52sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:letterSpacing="0.01"
                    android:text="I've Saved It"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/veil_accent"
                    app:cornerRadius="@dimen/_16sdp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
