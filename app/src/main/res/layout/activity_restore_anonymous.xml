<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/restore_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/colorTextPrimary" />
    </LinearLayout>

    <!-- Main Scrollable Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/_440sdp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_24sdp"
            android:paddingTop="@dimen/_64sdp"
            android:paddingBottom="@dimen/_36sdp">

            <!-- Circular Shield Icon Badge -->
            <FrameLayout
                android:layout_width="@dimen/_68sdp"
                android:layout_height="@dimen/_68sdp"
                android:layout_marginBottom="@dimen/_18sdp"
                android:background="@drawable/bg_restore_icon_circle">

                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Restore Account"
                    android:src="@drawable/ic_shield_locked"
                    app:tint="@color/veil_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="Restore Account"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/_22ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_26sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="Enter your 12-word recovery phrase to decrypt and recover your sovereign account."
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_14ssp" />

            <!-- Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_24sdp"
                android:background="@drawable/bg_phrase_card"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <!-- Card Header: Title & Paste Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="SECRET RECOVERY PHRASE"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <!-- Paste Quick Action Pill -->
                    <LinearLayout
                        android:id="@+id/btnPastePhrase"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_28sdp"
                        android:background="@drawable/bg_paste_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_10sdp">

                        <ImageView
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/veil_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Paste"
                            android:textColor="@color/veil_accent"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Input EditText -->
                <EditText
                    android:id="@+id/phraseEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:gravity="top|start"
                    android:hint="apple banana cherry dragon..."
                    android:inputType="textMultiLine"
                    android:lineSpacingExtra="@dimen/_5sdp"
                    android:minLines="3"
                    android:padding="0dp"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextSecondary"
                    android:textSize="@dimen/_15ssp" />

                <!-- Card Footer: Word Counter & Clear Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWordCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="0 / 12 words"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/_12ssp" />

                    <ImageView
                        android:id="@+id/btnClearPhrase"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear phrase"
                        android:padding="@dimen/_6sdp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/colorTextSecondary" />
                </LinearLayout>

            </LinearLayout>

            <!-- Restore Action Button with Centered In-Button Spinner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_52sdp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/restoreButton"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:letterSpacing="0.01"
                    android:text="Restore Account"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/veil_accent"
                    app:cornerRadius="@dimen/_16sdp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Privacy & Security Guarantee Footnote -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_22sdp"
                android:drawableStart="@drawable/ic_shield"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="Offline derivation • Private keys never leave your device"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_12ssp"
                app:drawableTint="@color/colorTextSecondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
