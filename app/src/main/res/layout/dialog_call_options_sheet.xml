<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_17sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/_13sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCallOptionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Call Options &amp; Security"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCallOptionsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="End-to-End Encrypted P2P WebRTC Mesh"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:background="@drawable/bg_filter_chip">

            <ImageView
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="@color/colorPrimary" />
        </FrameLayout>
    </LinearLayout>

    <!-- SECTION 1: Quick Emoji Reactions Bar in Sheet -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEND REACTION"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/_7sdp" />

    <LinearLayout
        android:id="@+id/sheetReactionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_13sdp">

        <TextView
            android:id="@+id/sheetRxHeart"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_filter_chip"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="❤️"
            android:textSize="@dimen/_18ssp" />

        <TextView
            android:id="@+id/sheetRxFire"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_filter_chip"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="🔥"
            android:textSize="@dimen/_18ssp" />

        <TextView
            android:id="@+id/sheetRxClap"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_filter_chip"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="👏"
            android:textSize="@dimen/_18ssp" />

        <TextView
            android:id="@+id/sheetRxLaugh"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_filter_chip"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="😂"
            android:textSize="@dimen/_18ssp" />

        <TextView
            android:id="@+id/sheetRxParty"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_filter_chip"
            android:layout_marginEnd="@dimen/_5sdp"
            android:text="🎉"
            android:textSize="@dimen/_18ssp" />

        <TextView
            android:id="@+id/sheetRxThumbsUp"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_filter_chip"
            android:text="👍"
            android:textSize="@dimen/_18ssp" />
    </LinearLayout>

    <!-- SECTION 2: Audio Route Picker Card -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AUDIO OUTPUT"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/_7sdp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp"
        android:layout_marginBottom="@dimen/_13sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_7sdp">

            <!-- Earpiece -->
            <LinearLayout
                android:id="@+id/optRouteEarpiece"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phone Earpiece"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <ImageView
                    android:id="@+id/ivCheckEarpiece"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Speakerphone -->
            <LinearLayout
                android:id="@+id/optRouteSpeaker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Speakerphone"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <ImageView
                    android:id="@+id/ivCheckSpeaker"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorPrimary"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Bluetooth -->
            <LinearLayout
                android:id="@+id/optRouteBluetooth"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_37sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎧"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bluetooth Headset"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <ImageView
                    android:id="@+id/ivCheckBluetooth"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECTION 3: In-Call Tools & Features -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IN-CALL TOOLS &amp; CONTROLS"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_9ssp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/_7sdp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_7sdp">

            <!-- In-Call Chat -->
            <LinearLayout
                android:id="@+id/optInCallChat"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Encrypted In-Call Chat"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <ImageView
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

            <!-- Group Call Participants -->
            <LinearLayout
                android:id="@+id/optParticipants"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Participants &amp; Mesh Roster"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <ImageView
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

            <!-- Low Data Mode Toggle -->
            <LinearLayout
                android:id="@+id/optLowDataMode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Low-Data Mode (Bandwidth Saver)"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLowData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Verify E2EE Key -->
            <LinearLayout
                android:id="@+id/optVerifyE2ee"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="@dimen/_13ssp"
                    android:layout_marginEnd="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Verify E2EE Fingerprint (SAS)"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_12ssp" />

                <ImageView
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
