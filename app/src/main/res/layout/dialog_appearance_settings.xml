<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_modern"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_attach_item"
            android:backgroundTint="@color/colorOutline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Wallpaper &amp; Appearance Studio"
            android:textColor="@color/colorTextPrimary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="14dp"
            android:text="Real-time chat styling with themes, photo crop, and dimming:"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12.5sp" />

        <!-- LIVE CHAT PREVIEW -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLivePreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.2dp"
            app:strokeColor="@color/colorOutline">

            <FrameLayout
                android:id="@+id/previewWallpaperContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0D1117">

                <ImageView
                    android:id="@+id/ivPreviewWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Dim Overlay -->
                <View
                    android:id="@+id/viewPreviewDimOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#00000000" />

                <!-- Sample Bubbles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <!-- Incoming Bubble -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="240dp"
                        android:background="@drawable/bg_message_received"
                        android:backgroundTint="@color/colorSurfaceVariant"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Veil zero-trace encrypted chat ✨"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Outgoing Bubble -->
                    <LinearLayout
                        android:id="@+id/previewOutgoingBubble"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:maxWidth="240dp"
                        android:background="@drawable/bg_message_sent"
                        android:backgroundTint="@color/colorPrimary"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp">

                        <TextView
                            android:id="@+id/tvPreviewOutgoingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live wallpaper preview looks awesome! 🚀"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 1: Themes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME MODE"
            android:textColor="@color/colorPrimary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rgThemeMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <RadioButton
                android:id="@+id/rbThemeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="System Default (Follow OS)"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbThemeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Light Theme"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbThemeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Dark Theme (OLED Friendly)"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- AMOLED Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌑 Pure AMOLED Black (#000000)"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="True 0% power black for battery savings"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAmoledBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorOutline"
            android:layout_marginBottom="14dp" />

        <!-- Section 2: Wallpaper Background -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WALLPAPER SOURCE"
            android:textColor="@color/colorPrimary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <!-- Custom Photo Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickPhotoWallpaper"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🖼️ Choose Custom Gallery Photo (Crop 9:16)"
            android:textSize="13.5sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Color Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solid Color Presets:"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:id="@+id/wpPresetDefault"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="#0D1117"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/wpPresetIndigo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="#121026"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/wpPresetEmerald"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="#091E1A"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/wpPresetCrimson"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="#240B15"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/wpPresetOcean"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#0A192F"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Dim Level Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wallpaper Dimming Level"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDimPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/colorPrimary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderWallpaperDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="80"
            android:stepSize="5"
            android:value="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorOutline"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp" />

        <!-- Section 3: Bubble Accent Colors -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Chat Bubble Accent Color"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/colorSwatchesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/colorCyan"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_color_swatch_cyan"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorEmerald"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_color_swatch_emerald"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorViolet"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_color_swatch_violet"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorAmber"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_color_swatch_amber"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/colorBlue"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_color_swatch_blue"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefaultWallpaper"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Reset to Default Wallpaper &amp; Accent"
            android:textColor="@color/colorError"
            app:strokeColor="@color/colorError"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
