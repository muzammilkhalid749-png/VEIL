<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Call History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/callsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_96sdp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/_32sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_72sdp"
                android:layout_height="@dimen/_72sdp"
                android:src="@drawable/ic_call_empty"
                android:layout_marginBottom="@dimen/_20sdp"
                app:tint="@color/textSecondary"
                android:contentDescription="@string/no_calls_yet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_calls_yet"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_20ssp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/_8sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_first_call"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_14ssp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp" />

        </LinearLayout>

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="visible" />

    </FrameLayout>

    <!-- Call Actions FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_96sdp"
        android:text="@string/new_call"
        android:textColor="@android:color/white"
        android:icon="@drawable/ic_call"
        app:backgroundTint="@color/colorPrimary"
        app:iconTint="@android:color/white"
        app:elevation="@dimen/_4sdp"
        android:visibility="gone" />

</RelativeLayout>
