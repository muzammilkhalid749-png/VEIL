<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/_18sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_18sdp"
    android:paddingBottom="@dimen/_22sdp">

    <!-- Minimal Drag Handle -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Vanish Trigger Mode"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_16ssp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:text="Choose when the disappearing timer countdown begins:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp" />

    <!-- Option 1: After Read -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVanishAfterRead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="After Read"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Countdown begins only after the recipient opens and views the message"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbVanishAfterRead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Option 2: After Send -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVanishAfterSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/colorSurfaceContainerLow"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/_1sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="After Send"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Countdown begins immediately from the instant message is dispatched"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/rbVanishAfterSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
