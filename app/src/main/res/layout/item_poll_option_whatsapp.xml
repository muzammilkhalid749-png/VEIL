<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poll_option_main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_4sdp"
    android:paddingEnd="@dimen/_4sdp"
    android:paddingTop="@dimen/_7sdp"
    android:paddingBottom="@dimen/_7sdp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- WhatsApp Circular Poll Option Checkbox (20dp) -->
        <FrameLayout
            android:id="@+id/poll_option_vote_checkbox"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:background="@drawable/bg_poll_checkbox_unchecked">

            <ImageView
                android:id="@+id/poll_option_check_icon"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Option Name -->
        <TextView
            android:id="@+id/poll_option_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:text="Option"
            android:textColor="@color/message_text_primary"
            android:textSize="@dimen/_15ssp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- End Wrapper: Voter Mini-Avatar Stack + Vote Count -->
        <LinearLayout
            android:id="@+id/poll_option_end_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/poll_voter_avatar_1"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_poll_checkbox_checked"
                android:gravity="center"
                android:text="Y"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/poll_voter_avatar_2"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginStart="@dimen/_minus8sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_voice_circle_received"
                android:gravity="center"
                android:text="P"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/poll_option_vote_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/message_text_secondary"
                android:textSize="@dimen/_13ssp" />
        </LinearLayout>
    </LinearLayout>

    <!-- WhatsApp Rounded Poll Vote Ratio Bar (indented 32dp to align with text) -->
    <ProgressBar
        android:id="@+id/poll_vote_ratio"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_poll_whatsapp" />

</LinearLayout>
