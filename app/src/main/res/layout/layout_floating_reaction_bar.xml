<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingReactionDock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_quick_react_dock"
    android:paddingStart="@dimen/_6sdp"
    android:paddingEnd="@dimen/_6sdp"
    android:paddingTop="@dimen/_3sdp"
    android:paddingBottom="@dimen/_3sdp"
    android:elevation="@dimen/_6sdp">

    <TextView
        android:id="@+id/floatingReactHeart"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="❤️"
        android:textSize="@dimen/_17ssp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactThumbsUp"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="👍"
        android:textSize="@dimen/_17ssp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactLaugh"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="😂"
        android:textSize="@dimen/_17ssp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactFire"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="🔥"
        android:textSize="@dimen/_17ssp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactWow"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="😮"
        android:textSize="@dimen/_17ssp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactPray"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="🙏"
        android:textSize="@dimen/_17ssp"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/floatingReactAddMore"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:padding="@dimen/_5sdp"
        android:src="@drawable/ic_add"
        app:tint="@color/text_secondary"
        android:layout_marginStart="@dimen/_2sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="More reactions" />

</LinearLayout>
