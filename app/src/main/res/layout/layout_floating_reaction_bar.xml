<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingReactionDock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_quick_react_dock"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:elevation="8dp">

    <TextView
        android:id="@+id/floatingReactHeart"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="❤️"
        android:textSize="20sp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactThumbsUp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="👍"
        android:textSize="20sp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactLaugh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="😂"
        android:textSize="20sp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactFire"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="🔥"
        android:textSize="20sp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactWow"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="😮"
        android:textSize="20sp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/floatingReactPray"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="🙏"
        android:textSize="20sp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/floatingReactAddMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:src="@drawable/ic_add"
        app:tint="@color/text_secondary"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="More reactions" />

</LinearLayout>
