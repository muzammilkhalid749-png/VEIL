<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Modern Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Personas"
        android:textColor="@color/textPrimary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/currentPersonaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current: @username"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorOutline"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/actionCreatePersona"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Create New Persona"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_add"
        app:drawableTint="@color/colorPrimary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
