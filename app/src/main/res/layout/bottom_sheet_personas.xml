<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_24sdp"
    android:paddingEnd="@dimen/_24sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Modern Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Personas"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_20ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:id="@+id/currentPersonaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current: @username"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_14ssp"
        android:layout_marginBottom="@dimen/_16sdp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/colorOutline"
        android:layout_marginBottom="@dimen/_12sdp" />

    <TextView
        android:id="@+id/actionCreatePersona"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:text="Create New Persona"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/_15ssp"
        android:fontFamily="sans-serif-medium"
        android:drawablePadding="@dimen/_16sdp"
        app:drawableStartCompat="@drawable/ic_add"
        app:drawableTint="@color/colorPrimary"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
