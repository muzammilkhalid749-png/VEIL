<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_modern"
    android:orientation="vertical">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/bg_persona_drag_handle" />

    <!-- Top Action Bar with Interactive Album Selector ("Recents ▼") -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/layoutGalleryAlbumSelector"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_38sdp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_10sdp">

            <TextView
                android:id="@+id/tvGalleryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Recents"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_17ssp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivGalleryAlbumChevron"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/textPrimary" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCloseGallery"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_close"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/colorOutline" />

    <!-- Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMediaGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/_4sdp"
            android:paddingBottom="@dimen/_76sdp" />

        <ProgressBar
            android:id="@+id/galleryProgressBar"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

        <!-- Modern Permission & Empty State View -->
        <LinearLayout
            android:id="@+id/layoutGalleryEmptyOrPermission"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/_32sdp"
            android:paddingEnd="@dimen/_32sdp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/_68sdp"
                android:layout_height="@dimen/_68sdp"
                android:background="@drawable/bg_persona_avatar_circle"
                android:backgroundTint="@color/colorSurfaceContainerHigh">

                <ImageView
                    android:id="@+id/ivGalleryEmptyIcon"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvGalleryEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Allow Access to Media"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_16ssp" />

            <TextView
                android:id="@+id/tvGalleryEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:text="To share photos and videos in your status or chat, grant VEIL access to your media library."
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/_13ssp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantGalleryPermission"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:fontFamily="sans-serif-medium"
                android:text="Grant Access"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_14ssp"
                app:cornerRadius="@dimen/_22sdp" />
        </LinearLayout>

        <!-- Scrim for Album Dropdown -->
        <View
            android:id="@+id/viewGalleryAlbumScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#26000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Floating Album Dropdown Menu Card (Screenshots 4.jpg & 5.jpg) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGalleryAlbumDropdown"
            android:layout_width="@dimen/_268sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="@dimen/_12sdp"
            app:strokeColor="@color/colorOutline"
            app:strokeWidth="@dimen/_1sdp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/_360sdp"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/llGalleryAlbumDropdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_8sdp" />
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Bottom-Right Folder / Multi-Select Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fabGalleryMultiOrFolder"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_52sdp"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/_16sdp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="@dimen/_8sdp"
            app:strokeColor="@color/colorOutline"
            app:strokeWidth="@dimen/_1sdp">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder_multi"
                app:tint="@color/textPrimary" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Bottom Caption & Send Bar (Telegram / WhatsApp Style) -->
    <LinearLayout
        android:id="@+id/bottomMediaActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:visibility="gone">

        <!-- Selected Preview Image -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorOutline"
            app:strokeWidth="@dimen/_1sdp">

            <ImageView
                android:id="@+id/ivSelectedPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Edit/Crop Button -->
        <ImageView
            android:id="@+id/btnEditSelectedMedia"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_crop"
            app:tint="@color/textPrimary" />

        <!-- Caption Input Field -->
        <EditText
            android:id="@+id/etMediaCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:hint="Add a caption..."
            android:maxLines="3"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:textSize="@dimen/_14ssp" />

        <!-- Send FAB Button -->
        <FrameLayout
            android:id="@+id/btnSendMedia"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/bg_voice_circle_received"
            android:backgroundTint="@color/colorPrimary">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@android:color/white" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
