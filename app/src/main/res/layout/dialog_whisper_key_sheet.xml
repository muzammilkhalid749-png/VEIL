<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_24sdp"
    android:paddingEnd="@dimen/_24sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One-Time Whisper Key"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_19ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_4sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Single-use ephemeral key that self-destructs upon connection:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_13ssp"
        android:layout_marginBottom="@dimen/_18sdp" />

    <!-- My Generated Key Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="#F59E0B"
        app:cardBackgroundColor="@color/surfaceVariant"
        android:layout_marginBottom="@dimen/_18sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR ONETIME BURN KEY"
                android:textColor="#F59E0B"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/_6sdp" />

            <TextView
                android:id="@+id/tvWhisperMyCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHISPER-0000"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/_22ssp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_marginBottom="@dimen/_12sdp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyWhisperCode"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:text="Copy Key"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                android:textSize="@dimen/_13ssp"
                app:cornerRadius="@dimen/_10sdp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OR ENTER PEER'S KEY TO CONNECT"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="@dimen/_8sdp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPeerWhisperCode"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        app:boxCornerRadiusBottomEnd="@dimen/_12sdp"
        app:boxCornerRadiusBottomStart="@dimen/_12sdp"
        app:boxCornerRadiusTopEnd="@dimen/_12sdp"
        app:boxCornerRadiusTopStart="@dimen/_12sdp"
        app:boxStrokeColor="@color/colorPrimary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPeerWhisperCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste peer's whisper key (e.g. WHISPER-XXXX)"
            android:textAllCaps="true"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnectWhisper"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:text="Connect &amp; Burn Key"
        app:cornerRadius="@dimen/_12sdp" />

</LinearLayout>
