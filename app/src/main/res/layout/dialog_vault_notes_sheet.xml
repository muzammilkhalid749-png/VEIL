<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="@dimen/_20sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_23sdp">

    <!-- Handle Bar -->
    <View
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_3sdp"
        android:background="@drawable/bg_persona_drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Private Notes Vault"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/_16ssp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/_3sdp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Private notes stored securely on your device:"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/_11ssp"
        android:layout_marginBottom="@dimen/_13sdp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/_200sdp"
        android:layout_marginBottom="@dimen/_12sdp">

        <LinearLayout
            android:id="@+id/vaultNotesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/_7sdp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddVaultNote"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_7sdp"
            android:text="Add Note"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:cornerRadius="@dimen/_10sdp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFutureCapsule"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:text="Future Capsule"
            app:icon="@drawable/ic_timer"
            app:iconGravity="textStart"
            app:cornerRadius="@dimen/_10sdp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportVaultBackup"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:text="Export Encrypted Vault Backup"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:cornerRadius="@dimen/_10sdp" />

</LinearLayout>
